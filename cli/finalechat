# Exit codes shared by every waiting command.
EXIT_OK = 0
EXIT_USAGE = 1
EXIT_API = 2
EXIT_TIMEOUT = 3
EXIT_RESOLVED = 4  # question cancelled, expired or dismissed

# The API caps one long-poll at 600 seconds; we chain them. Hooks poll in
# shorter chunks so a remote-mode switch is noticed quickly.
POLL_CHUNK = 600
HOOK_WAIT_CHUNK = 30

# Attachment limits mirror the server's.
MAX_ATTACHMENT_BYTES = 10 * 1024 * 1024
MAX_ATTACHMENTS = 8
# Images larger than this are handed to MCP clients as thumbnails.
