def client_from_args(args) -> Client:
    return Client(resolve_base_url(getattr(args, "url", None)), resolve_token(getattr(args, "token", None)))


def cmd_login(args) -> int:
    base_url = resolve_base_url(args.url)
    token = args.token_arg or os.environ.get("FINALECHAT_TOKEN")
    if not token:
        if not sys.stdin.isatty():
            token = read_stdin_text().strip()
        else:
            print(f"Create a token in Settings → Agents at {base_url}/settings", file=sys.stderr)
            token = getpass.getpass("API token (fc_…): ").strip()
    if not token:
        raise CLIError("No token given.")
    if not token.startswith("fc_"):
        raise CLIError("That does not look like a Finalechat token; they start with fc_.")
    client = Client(base_url, token)
    me = client.me()
    config = load_config()
    config.update({"token": token, "base_url": base_url})
    save_config(config)
    email = (me.get("user") or {}).get("email", "?")
    print(f"Signed in as {email} at {base_url}")
    return EXIT_OK


def cmd_logout(args) -> int:
    try:
        CONFIG_PATH.unlink()
        print("Signed out; token removed from", CONFIG_PATH)
    except FileNotFoundError:
        print("Not signed in.")
    return EXIT_OK


def cmd_whoami(args) -> int:
    client = client_from_args(args)
    me = client.me()
    if args.json:
        print_json(me)
        return EXIT_OK
    user = me.get("user") or {}
    counts = me.get("counts") or {}
    settings = user.get("settings") or {}
    print(f"{user.get('email', '?')}  ({user.get('display_name') or 'no display name'})")
    print(f"server      {client.base_url}  v{me.get('version', '?')}")
    token = me.get("token") or {}
    if token:
        print(f"token       {token.get('name', '?')} ({token.get('prefix', '')}…)")
    print(f"remote mode {'on' if settings.get('remote_mode') else 'off'}")
    print(f"inbox       {counts.get('pending_questions', 0)} pending question(s), "
          f"{counts.get('unread_threads', 0)} unread thread(s)")
    return EXIT_OK


def cmd_threads(args) -> int:
    client = client_from_args(args)
    threads = client.list_threads(archived=args.archived, limit=args.limit)
    if args.json:
        print_json({"threads": threads})
        return EXIT_OK
    if not threads:
        print("No archived threads." if args.archived else "No threads yet.")
        return EXIT_OK
    width = shutil.get_terminal_size((100, 20)).columns
    for t in threads:
        flags = ("?" if t.get("pending_questions") else " ") + ("•" if t.get("unread_count") else " ")
        title = t.get("title") or "(untitled)"
        agent = t.get("agent") or ""
        when = relative_time(t.get("last_activity_at"))
        head = f"{flags} {title}"
        if agent:
            head += f"  [{agent}]"
        head += f"  {when}"
        print(head)
        preview = t.get("preview") or ""
        if preview:
            print("     " + truncate(preview, max(20, width - 6)))
        print(f"     id {t.get('id')}" + (f"  ext {t.get('external_id')}" if t.get("external_id") else ""))
    return EXIT_OK


def cmd_read(args) -> int:
    client = client_from_args(args)
    target = resolve_target(args.ref or args.thread)
    resp = client.list_messages(target.ref, limit=args.limit)
    messages = resp.get("messages") or []
    if args.json:
        print_json(resp)
        return EXIT_OK
    if not messages:
        print("(no messages)")
        return EXIT_OK
    for m in messages:
        stamp = local_clock(m.get("created_at"))
        sender = m.get("sender", "?")
        body = (m.get("body") or "").rstrip()
        lines = body.split("\n") or [""]
        prefix = f"{stamp} {sender:>6} › "
        print(prefix + lines[0])
        pad = " " * len(prefix)
        for line in lines[1:]:
            print(pad + line)
        for att in message_attachments(m):
            print(pad + attachment_line(client, att))
    return EXIT_OK


def cmd_say(args) -> int:
    client = client_from_args(args)
    files = read_local_files(args.file or [])
    if args.message and args.message != ["-"]:
        body = " ".join(args.message)
    elif args.message == ["-"] or not files:
        # No text given: read it from stdin, as before attachments existed.
        body = read_stdin_text()
    else:
        # Files without text: the message is the attachments themselves.
        body = ""
    if not body.strip() and not files:
        raise CLIError("Nothing to send. Pass the message as arguments, on stdin, or attach a file with -f.")
    target = resolve_target(args.thread, args.title, args.agent)
    notify = None
    if args.notify is True:
        notify = True
    elif args.notify is False:
        notify = False
    resp = client.post_message(target.ref, body, important=args.important, notify=notify,
                               fmt="text" if args.text else "markdown", title=target.title, agent=target.agent,
                               files=files)
    if args.json:
        print_json(resp)
        return EXIT_OK
    thread = resp.get("thread") or {}
    message = resp.get("message") or {}
    print(f"sent · thread {thread.get('id')} · message {message.get('id')}")
    for att in message_attachments(message):
        print("  " + attachment_line(client, att))
    return EXIT_OK


def cmd_fetch(args) -> int:
    client = client_from_args(args)
    target = save_attachment(client, args.attachment, args.output)
    print(target)
    return EXIT_OK


def cmd_delete(args) -> int:
    client = client_from_args(args)
    resp = client.delete_message(args.message_id)
    if args.json:
        print_json(resp)
    else:
        print(f"deleted · message {args.message_id}")
    return EXIT_OK


def describe_activity(activity: dict | None) -> str:
    if not activity:
        return "no status"
    text = str(activity.get("text") or "")
    kind = str(activity.get("kind") or "working")
    since = relative_time(activity.get("since"))
    return f"{kind}: {text} (since {since})"


def cmd_status(args) -> int:
    client = client_from_args(args)
    target = resolve_target(args.thread, args.title, args.agent)
    text = " ".join(args.text or []).strip()
    if args.clear:
        resp = client.clear_activity(target.ref)
    elif text:
        resp = client.set_activity(target.ref, text, kind=args.kind, ttl=args.ttl, seq=args.seq,
                                   title=target.title, agent=target.agent)
    else:
        thread = client.get_thread(target.ref)
        if args.json:
            print_json(thread)
        else:
            print(describe_activity(thread.get("activity")))
        return EXIT_OK
    if args.json:
        print_json(resp)
        return EXIT_OK
    thread = resp.get("thread") or {}
    activity = thread.get("activity")
    if text and resp.get("applied") is False:
        print(f"status unchanged · thread {thread.get('id')} · a newer or identical status is live: {describe_activity(activity)}")
    elif activity:
        expires = parse_time(activity.get("expires_at"))
        left = max(0, int((expires - datetime.now(timezone.utc)).total_seconds())) if expires else 0
        print(f"status set · thread {thread.get('id')} · lapses in {left}s or at your next message")
    else:
        print(f"status cleared · thread {thread.get('id')}")
    return EXIT_OK


def parse_options(raw: list[str] | None) -> list[dict]:
    options = []
    for item in raw or []:
        if "::" in item:
            label, description = item.split("::", 1)
        else:
            label, description = item, ""
        label = label.strip()
        if not label:
            raise CLIError("Option labels cannot be empty.")
        option = {"label": label}
        if description.strip():
            option["description"] = description.strip()
        options.append(option)
    return options


def finish_question(question: dict, as_json: bool) -> int:
    status = question.get("status")
    if as_json:
        print_json(question)
    if status == "answered":
        if not as_json:
            print(format_answer(question))
        return EXIT_OK
    if status == "pending":
        print(f"No answer yet. Question {question.get('id')} is still pending; "
              f"resume with `finalechat wait-answer {question.get('id')}`", file=sys.stderr)
        return EXIT_TIMEOUT
    if status == "dismissed":
        print(f"The user dismissed question {question.get('id')}; do not ask it again.", file=sys.stderr)
    else:
        print(f"Question {question.get('id')} was {status}.", file=sys.stderr)
    return EXIT_RESOLVED


def cmd_ask(args) -> int:
    client = client_from_args(args)
    prompt = args.prompt
    if prompt == "-":
        prompt = read_stdin_text()
    if not prompt.strip():
        raise CLIError("The prompt is empty.")
    options = parse_options(args.option)
    if not options and args.no_freeform:
        raise CLIError("A question without options must allow free-form answers.")
    target = resolve_target(args.thread, args.title, args.agent)
    resp = client.ask(target.ref, prompt, options, multi=args.multi, freeform=not args.no_freeform,
                      timeout_seconds=args.timeout, title=target.title, agent=target.agent)
    question = resp.get("question") or {}
    if not question.get("id"):
        raise CLIError("The server did not return a question.", EXIT_API)
    if args.wait > 0:
        print(f"asked · question {question['id']} · waiting up to {args.wait}s", file=sys.stderr)
        question = wait_for_answer(client, question["id"], args.wait)
    return finish_question(question, args.json)


def cmd_wait_answer(args) -> int:
    client = client_from_args(args)
    question = wait_for_answer(client, args.question_id, args.wait)
    return finish_question(question, args.json)


def cmd_wait(args) -> int:
    client = client_from_args(args)
    target = resolve_target(args.thread)
    after = args.after
    if after is None:
        after = latest_message_id(client, target.ref)
    message = wait_for_reply(client, target.ref, after, args.timeout)
    if message is None:
        print("No reply within the timeout.", file=sys.stderr)
        return EXIT_TIMEOUT
    if args.json:
        print_json(message)
    else:
        body = message.get("body", "")
        if body:
            print(body)
        for att in message_attachments(message):
            print(attachment_line(client, att))
    return EXIT_OK


def cmd_remote(args) -> int:
    client = client_from_args(args)
    action = args.action or "status"
    if action == "status":
        state = client.remote_mode()
    else:
        settings = client.update_settings(remote_mode=(action == "on"))
        state = bool(settings.get("remote_mode"))
    print(f"remote mode {'on' if state else 'off'}")
    if action == "status" and not state:
        print("  Claude Code hooks post to your phone but do not wait for replies.", file=sys.stderr)
    elif state:
        print("  Claude Code sessions will block for replies and answers from the app.", file=sys.stderr)
    return EXIT_OK


