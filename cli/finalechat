MCP_MAX_IMAGES = 4


# --------------------------------------------------------------------------- #
# Errors
# --------------------------------------------------------------------------- #


class CLIError(Exception):
    """A user-facing failure with an exit code."""

    exit_code = EXIT_USAGE

    def __init__(self, message: str, exit_code: int | None = None):
        super().__init__(message)
        if exit_code is not None:
            self.exit_code = exit_code


class APIError(CLIError):
    """The server answered with an error envelope."""

    exit_code = EXIT_API

    def __init__(self, status: int, code: str, message: str, retry_after: float = 0.0):
        super().__init__(message)
        self.status = status
        self.code = code
        self.retry_after = retry_after


class NotSignedIn(CLIError):
    def __init__(self):
        super().__init__("Not signed in. Run `finalechat login` or set FINALECHAT_TOKEN.")


# --------------------------------------------------------------------------- #
# Config
