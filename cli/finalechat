# Attachments
# --------------------------------------------------------------------------- #

UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.IGNORECASE)


def attachment_id(ref: str) -> str:
    """Accept an attachment id, a relative API path, or an absolute URL."""
    ref = (ref or "").strip()
    match = UUID_RE.search(ref)
    if not match or ("/" in ref and "/attachments/" not in ref):
        raise CLIError(f"Not an attachment id or URL: {ref!r}")
    return match.group(0).lower()


def filename_from_disposition(value: str) -> str:
    match = re.search(r"filename\*=UTF-8\'\'([^;]+)", value)
    if match:
        return urllib.parse.unquote(match.group(1)).strip()
    match = re.search(r'filename="((?:[^"\\]|\\.)*)"', value)
    if match:
        return match.group(1).replace('\\"', '"').strip()
    match = re.search(r"filename=([^;]+)", value)
    if match:
        return match.group(1).strip().strip('"')
    return ""


def human_size(size) -> str:
    try:
        n = float(size)
    except (TypeError, ValueError):
        return "?"
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{int(n)} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} GB"


def attachment_line(client: Client, att: dict) -> str:
    url = att.get("url") or ""
    if url.startswith("/"):
        url = client.base_url + url
    return f"📎 {att.get('filename') or att.get('id')} ({att.get('content_type', '?')}, {human_size(att.get('size'))}) {url}"


def message_attachments(message: dict) -> list:
    return [a for a in (message.get("attachments") or []) if isinstance(a, dict)]


def attachment_hint(message: dict) -> str:
    """Sentence telling an agent how to get at the files on a reply."""
    atts = message_attachments(message)
    if not atts:
        return ""
    descs = []
    for a in atts:
        name = a.get("filename") or a.get("id")
        descs.append(f"{name} ({a.get('content_type', '?')})")
    first = atts[0]
    first_name = os.path.basename(first.get("filename") or "attachment") or "attachment"
    noun = "attachment" if len(atts) == 1 else "attachments"
    target = shlex.quote(os.path.join("/tmp", first_name))
    return (f" The reply includes {len(atts)} {noun}: " + ", ".join(descs) +
            f" — download with `finalechat fetch {first.get('id')} -o {target}`"
            + (" (one fetch per id)" if len(atts) > 1 else "") + " and read the file to view it.")


def read_local_files(paths: list) -> list:
    """Load files for upload as (filename, content_type, bytes), enforcing limits up front."""
    if len(paths) > MAX_ATTACHMENTS:
        raise CLIError(f"At most {MAX_ATTACHMENTS} files per message.")
    files = []
    for raw in paths:
        path = os.path.expanduser(str(raw))
        if not os.path.isfile(path):
            raise CLIError(f"No such file: {path}")
        size = os.path.getsize(path)
        if size > MAX_ATTACHMENT_BYTES:
            raise CLIError(f"{path} is {human_size(size)} ({size} bytes); attachments must be at most 10 MB ({MAX_ATTACHMENT_BYTES} bytes).")
        if size == 0:
            raise CLIError(f"{path} is empty.")
        content_type = mimetypes.guess_type(path)[0] or "application/octet-stream"
        with open(path, "rb") as fh:
            files.append((os.path.basename(path), content_type, fh.read()))
    return files


def unique_path(path: str) -> str:
    """Return `path`, or a numbered variant if it already exists."""
    if not os.path.exists(path):
        return path
    stem, ext = os.path.splitext(path)
    for i in range(1, 10_000):
        candidate = f"{stem}-{i}{ext}"
        if not os.path.exists(candidate):
            return candidate
    raise CLIError(f"Could not find a free filename near {path}")


def save_attachment(client: Client, ref: str, out: str | None) -> str:
    data, _content_type, filename = client.download_attachment(ref)
    if out:
        target = os.path.expanduser(out)
        if os.path.isdir(target):
            safe = os.path.basename(filename)
            if safe in ("", ".", ".."):
                safe = attachment_id(ref)
            target = os.path.join(target, safe)
    else:
        target = os.path.join(os.getcwd(), os.path.basename(filename) or attachment_id(ref))
    target = unique_path(target)
    parent = os.path.dirname(target)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(target, "wb") as fh:
        fh.write(data)
    return target


# --------------------------------------------------------------------------- #
# Thread resolution
# --------------------------------------------------------------------------- #


def hostname() -> str:
    try:
        return socket.gethostname().split(".")[0] or "host"
    except OSError:
        return "host"


def cwd_key(path: str) -> str:
    return hashlib.sha1(os.path.abspath(path).encode("utf-8")).hexdigest()


def _load_sessions(target: Path) -> dict:
    """The per-directory session map: {session_id: {external_id, pid, updated_at}}."""
    try:
        with target.open() as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return {}
    sessions = data.get("sessions") if isinstance(data, dict) else None
    if isinstance(sessions, dict):
        return sessions
    # An older single-session pointer file.
    if isinstance(data, dict) and data.get("external_id") and data.get("session_id"):
        return {str(data["session_id"]): {"external_id": data["external_id"], "pid": 0, "updated_at": data.get("updated_at", 0)}}
    return {}


def _save_sessions(target: Path, sessions: dict, cwd: str) -> None:
    BY_CWD_DIR.mkdir(parents=True, exist_ok=True)
    tmp = target.with_suffix(".tmp")
    with tmp.open("w") as fh:
        json.dump({"cwd": os.path.abspath(cwd), "sessions": sessions}, fh)
    tmp.replace(target)


def _pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False


def _ancestor_pids() -> set:
    """Every process above this one, so a CLI run from inside a Claude Code
    session can tell which session it belongs to."""
    pids: set = set()
    pid = os.getppid()
    for _ in range(64):
        if pid <= 1 or pid in pids:
            break
        pids.add(pid)
        parent = 0
        try:
            with open(f"/proc/{pid}/stat") as fh:
                stat = fh.read()
            parent = int(stat.rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            try:
                out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True, timeout=2).stdout
                parent = int(out.strip() or 0)
            except (OSError, ValueError, subprocess.SubprocessError):
                parent = 0
        pid = parent
    return pids


def read_by_cwd_pointer(path: str | None = None) -> dict | None:
    """The thread the Claude Code session that spawned this process is using,
    or, when no ancestor is a known session, the most recently active live
    session in this directory. Two sessions in one directory therefore stop
    posting into each other's threads."""
    target = BY_CWD_DIR / f"{cwd_key(path or os.getcwd())}.json"
    sessions = _load_sessions(target)
    if not sessions:
        return None
    now = time.time()
    live = {sid: s for sid, s in sessions.items()
            if isinstance(s, dict) and s.get("external_id") and now - float(s.get("updated_at") or 0) <= BY_CWD_MAX_AGE
            and (not s.get("pid") or _pid_alive(int(s.get("pid") or 0))
                 or now - float(s.get("updated_at") or 0) <= BY_CWD_DEAD_GRACE)}
    if len(live) != len(sessions):
        try:
            _save_sessions(target, live, path or os.getcwd())
        except OSError:
            pass
    if not live:
        return None
    ancestors = _ancestor_pids()
    for sid, s in live.items():
        if s.get("pid") and int(s["pid"]) in ancestors:
            return {"external_id": s["external_id"], "session_id": sid}
    sid, s = max(live.items(), key=lambda kv: float(kv[1].get("updated_at") or 0))
    return {"external_id": s["external_id"], "session_id": sid}


def clear_by_cwd_pointer(cwd: str, session_id: str) -> None:
    """Forget a session when it ends."""
    target = BY_CWD_DIR / f"{cwd_key(cwd)}.json"
    sessions = _load_sessions(target)
    if session_id in sessions:
        sessions.pop(session_id, None)
        try:
            if sessions:
                _save_sessions(target, sessions, cwd)
            else:
                target.unlink()
        except OSError:
            pass


def _claude_pid() -> int:
    """The Claude Code process this hook or command belongs to: Claude Code
    tells its children with CLAUDE_PID; a hook's parent is it otherwise."""
    try:
        pid = int(os.environ.get("CLAUDE_PID") or 0)
    except ValueError:
        pid = 0
    return pid if pid > 0 and _pid_alive(pid) else os.getppid()


def write_by_cwd_pointer(cwd: str, external_id: str, session_id: str) -> None:
    """Record (or refresh) a session for this directory and for its Claude
    Code process. The pid is always taken afresh: a resumed session runs in
    a new process, and its first hook must repoint the map at once."""
    pid = _claude_pid()
    target = BY_CWD_DIR / f"{cwd_key(cwd)}.json"
    sessions = _load_sessions(target)
    entry = sessions.get(session_id) or {}
    entry.update({"external_id": external_id, "updated_at": time.time(), "pid": pid})
    sessions[session_id] = entry
    _save_sessions(target, sessions, cwd)
    # The by-pid index answers "which session am I inside?" for a command
    # run from any directory, including a subdirectory of the session's.
    try:
        BY_PID_DIR.mkdir(parents=True, exist_ok=True)
        tmp = BY_PID_DIR / f"{pid}.tmp"
        with tmp.open("w") as fh:
            json.dump({"external_id": external_id, "session_id": session_id, "cwd": os.path.abspath(cwd),
                       "updated_at": time.time()}, fh)
        tmp.replace(BY_PID_DIR / f"{pid}.json")
    except OSError:
        pass


def read_by_pid_pointer() -> dict | None:
    """The session whose Claude Code process is an ancestor of this one, if
    any hook of it has run; the nearest ancestor wins."""
    if not BY_PID_DIR.is_dir():
        return None
    for pid in _ancestor_pids_ordered():
        path = BY_PID_DIR / f"{pid}.json"
        if not path.is_file():
            continue
        try:
            with path.open() as fh:
                data = json.load(fh)
        except (OSError, ValueError):
            continue
        if isinstance(data, dict) and data.get("external_id"):
            return {"external_id": str(data["external_id"]), "session_id": str(data.get("session_id") or "")}
    return None


def _ancestor_pids_ordered() -> list:
    """Ancestors nearest first (the set form is what the cwd map wants)."""
    pids: list = []
    pid = os.getppid()
    for _ in range(64):
        if pid <= 1 or pid in pids:
            break
        pids.append(pid)
        parent = 0
        try:
            with open(f"/proc/{pid}/stat") as fh:
                stat = fh.read()
            parent = int(stat.rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            try:
                out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True, timeout=2).stdout
                parent = int(out.strip() or 0)
            except (OSError, ValueError, subprocess.SubprocessError):
                parent = 0
        pid = parent
    return pids


class ThreadTarget:
    """A thread reference plus the naming to use if it has to be created."""

    def __init__(self, ref: str, title: str = "", agent: str = ""):
        self.ref = ref
        self.title = title
        self.agent = agent

    def __str__(self) -> str:
        return self.ref


def default_agent(fallback: str = "Terminal") -> str:
    return os.environ.get("FINALECHAT_AGENT") or fallback


def resolve_target(explicit: str | None = None, title: str | None = None, agent: str | None = None,
                   fallback_agent: str = "Terminal", fallback_prefix: str = "cli") -> ThreadTarget:
    """Which thread a command means, in order: an explicit ref, $FINALECHAT_THREAD,
    the Claude Code session this process runs inside (Claude Code names it in
    $CLAUDE_CODE_SESSION_ID; failing that, a session whose process is an
    ancestor of ours), the most recent live session in this directory or a
    parent of it, and last a thread per directory."""
    cwd = os.getcwd()
    if explicit:
        return ThreadTarget(explicit, title or "", agent or "")
    env = os.environ.get("FINALECHAT_THREAD")
    if env:
        return ThreadTarget(env, title or "", agent or "")
    session = os.environ.get("CLAUDE_CODE_SESSION_ID", "").strip()
    if session:
        return ThreadTarget("ext:claude-code:" + session, title or "", agent or "")
    pointer = read_by_pid_pointer()
    if pointer:
        return ThreadTarget("ext:" + pointer["external_id"], title or "", agent or "")
    directory = os.path.abspath(cwd)
    while True:
        pointer = read_by_cwd_pointer(directory)
        if pointer:
            return ThreadTarget("ext:" + pointer["external_id"], title or "", agent or "")
        parent = os.path.dirname(directory)
        if parent == directory:
            break
        directory = parent
    ext = f"ext:{fallback_prefix}:{hostname()}:{os.path.abspath(cwd)}"
    if sys.stderr.isatty():
        print(f"finalechat: no agent session found here; using this directory's thread ({ext})", file=sys.stderr)
    return ThreadTarget(ext, title or os.path.basename(os.path.abspath(cwd)) or "Terminal",
                        agent or default_agent(fallback_agent))


def missing_thread(err: APIError, target: ThreadTarget) -> APIError:
    """A 404 on a thread route, with the ref and what creates one."""
    if err.status != 404:
        return err
    return APIError(404, err.code or "not_found",
                    f"No thread {target.ref} yet. `finalechat say` (or finalechat_send) creates it; "
                    f"`finalechat threads` lists the ones that exist.", err.retry_after)


