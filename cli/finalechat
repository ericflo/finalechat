SESSIONS_DIR = CLAUDE_CACHE / "sessions"

HOOK_MARKER = "finalechat hook claude-code"
BY_CWD_MAX_AGE = 24 * 3600

# Exit codes shared by every waiting command.
EXIT_OK = 0
EXIT_USAGE = 1
EXIT_API = 2
EXIT_TIMEOUT = 3
EXIT_RESOLVED = 4  # question cancelled, expired or dismissed

# The API caps one long-poll at 600 seconds; we chain them. Hooks poll in
# shorter chunks so a remote-mode switch is noticed quickly.
POLL_CHUNK = 600
HOOK_WAIT_CHUNK = 30

# Attachment limits mirror the server's.
MAX_ATTACHMENT_BYTES = 10 * 1024 * 1024
MAX_ATTACHMENTS = 8
# Images larger than this are handed to MCP clients as thumbnails.
MCP_IMAGE_INLINE_LIMIT = 4 * 1024 * 1024
MCP_MAX_IMAGES = 4


# --------------------------------------------------------------------------- #
# Errors
# --------------------------------------------------------------------------- #


class CLIError(Exception):
    """A user-facing failure with an exit code."""

    exit_code = EXIT_USAGE

    def __init__(self, message: str, exit_code: int | None = None):
        super().__init__(message)
        if exit_code is not None:
            self.exit_code = exit_code


class APIError(CLIError):
    """The server answered with an error envelope."""

    exit_code = EXIT_API

    def __init__(self, status: int, code: str, message: str, retry_after: float = 0.0):
        super().__init__(message)
        self.status = status
        self.code = code
        self.retry_after = retry_after


class NotSignedIn(CLIError):
    def __init__(self):
        super().__init__("Not signed in. Run `finalechat login` or set FINALECHAT_TOKEN.")


# --------------------------------------------------------------------------- #
# Config
# --------------------------------------------------------------------------- #


def load_config() -> dict:
    try:
        with CONFIG_PATH.open() as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_config(data: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(CONFIG_DIR, 0o700)
    except OSError:
        pass
    tmp = CONFIG_PATH.with_suffix(".json.tmp")
    with tmp.open("w") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.chmod(tmp, 0o600)
    tmp.replace(CONFIG_PATH)


def resolve_base_url(explicit: str | None = None) -> str:
    url = explicit or os.environ.get("FINALECHAT_URL") or load_config().get("base_url") or DEFAULT_BASE_URL
    return str(url).rstrip("/")


def resolve_token(explicit: str | None = None) -> str | None:
    token = explicit or os.environ.get("FINALECHAT_TOKEN") or load_config().get("token")
    token = (token or "").strip()
    return token or None


# --------------------------------------------------------------------------- #
# HTTP client
# --------------------------------------------------------------------------- #


class Client:
    def __init__(self, base_url: str, token: str | None):
        self.base_url = base_url.rstrip("/")
        self.token = token
        # A wall-clock budget (time.monotonic()) after which requests stop
        # retrying and shorten their timeouts; hooks that Claude Code kills
        # after 30 seconds set it so a slow server cannot stall a prompt.
        self.deadline: float | None = None

    # -- transport ---------------------------------------------------------

    def request(self, method: str, path: str, body: dict | None = None, params: dict | None = None,
                timeout: float = 15.0, retries: int | None = None) -> dict:
        """One JSON request. GETs, and POSTs that carry an idempotency key, are
        retried on transport errors, 429 and 5xx with a short backoff, so a
        deploy or a blip neither ends a long wait nor loses a message."""
        if retries is None:
            retries = 3 if method == "GET" or (body or {}).get("client_key") else 0
        delay = 1.0
        for attempt in range(retries + 1):
            attempt_timeout = timeout
            if self.deadline is not None:
                left = self.deadline - time.monotonic()
                if left <= 1.0:
                    raise CLIError(f"Out of time talking to {self.base_url}", EXIT_API)
                attempt_timeout = min(timeout, left)
            try:
                return self._request_once(method, path, body, params, attempt_timeout)
            except NotSignedIn:
                raise
            except (APIError, CLIError) as err:
                if isinstance(err, APIError):
                    transient = err.status in (429, 502, 503, 504)
                else:
                    transient = err.exit_code == EXIT_API
                if not transient or attempt >= retries:
                    raise
                wait = delay
                if isinstance(err, APIError) and err.retry_after:
                    wait = max(wait, min(30.0, err.retry_after))
                if self.deadline is not None and time.monotonic() + wait + 1.0 > self.deadline:
                    raise
                time.sleep(wait)
                delay = min(8.0, delay * 2)
        raise CLIError("request failed", EXIT_API)  # not reached

    def _request_once(self, method: str, path: str, body: dict | None, params: dict | None,
                      timeout: float) -> dict:
        if not self.token:
            raise NotSignedIn()
        url = self.base_url + path
        if params:
            clean = {k: v for k, v in params.items() if v is not None and v != ""}
            if clean:
                url += "?" + urllib.parse.urlencode(clean)
        data = None
        headers = {
            "Authorization": f"Bearer {self.token}",
            "Accept": "application/json",
            "User-Agent": USER_AGENT,
        }
        if body is not None:
            data = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        req = urllib.request.Request(url, data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                raw = resp.read()
        except urllib.error.HTTPError as err:
            raw = err.read()
            try:
                retry_after = float(err.headers.get("Retry-After") or 0)
            except (TypeError, ValueError):
                retry_after = 0.0
            try:
                payload = json.loads(raw.decode("utf-8"))
                info = payload.get("error") or {}
                raise APIError(err.code, str(info.get("code") or "http_error"),
                               str(info.get("message") or f"HTTP {err.code}"), retry_after) from None
            except ValueError:
                raise APIError(err.code, "http_error", f"HTTP {err.code} from {url}", retry_after) from None
        except urllib.error.URLError as err:
            raise CLIError(f"Could not reach {self.base_url}: {err.reason}", EXIT_API) from None
        except (socket.timeout, TimeoutError):
            raise CLIError(f"Timed out talking to {self.base_url}", EXIT_API) from None
        if not raw:
            return {}
        try:
            return json.loads(raw.decode("utf-8"))
        except ValueError:
            raise CLIError(f"Unexpected non-JSON response from {url}", EXIT_API) from None

    def request_bytes(self, method: str, path: str, *, data: bytes | None = None,
                      content_type: str | None = None, timeout: float = 120.0) -> tuple[bytes, dict]:
        """Send a request with a prepared body and return (body bytes, headers)."""
        if not self.token:
            raise NotSignedIn()
        url = path if path.startswith("http") else self.base_url + path
        headers = {
            "Authorization": f"Bearer {self.token}",
            "Accept": "application/json, */*",
            "User-Agent": USER_AGENT,
        }
        if content_type:
            headers["Content-Type"] = content_type
        req = urllib.request.Request(url, data=data, method=method, headers=headers)
        try:
            with urllib.request.urlopen(req, timeout=timeout) as resp:
                return resp.read(), {k.lower(): v for k, v in resp.headers.items()}
        except urllib.error.HTTPError as err:
            raw = err.read()
            try:
                payload = json.loads(raw.decode("utf-8"))
                info = payload.get("error") or {}
                raise APIError(err.code, str(info.get("code") or "http_error"),
                               str(info.get("message") or f"HTTP {err.code}")) from None
            except ValueError:
                raise APIError(err.code, "http_error", f"HTTP {err.code} from {url}") from None
        except urllib.error.URLError as err:
            raise CLIError(f"Could not reach {self.base_url}: {err.reason}", EXIT_API) from None
        except socket.timeout:
            raise CLIError(f"Timed out talking to {self.base_url}", EXIT_API) from None

    def post_multipart(self, path: str, fields: dict, files: list) -> dict:
        """POST multipart/form-data. `files` is a list of (filename, content_type, bytes)."""
        boundary = "finalechat-" + secrets.token_hex(16)
        chunks: list[bytes] = []
        for name, value in fields.items():
            if value is None or value == "":
                continue
            chunks.append((f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"\r\n\r\n").encode("utf-8"))
            chunks.append(str(value).encode("utf-8"))
            chunks.append(b"\r\n")
        for filename, content_type, data in files:
            safe_name = filename.replace("\\", "_").replace('"', "_").replace("\r", "").replace("\n", "")
            chunks.append((f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; "
                           f"filename=\"{safe_name}\"\r\nContent-Type: {content_type}\r\n\r\n").encode("utf-8"))
            chunks.append(data)
            chunks.append(b"\r\n")
        chunks.append(f"--{boundary}--\r\n".encode("utf-8"))
        body = b"".join(chunks)
        raw, _ = self.request_bytes("POST", path, data=body,
                                    content_type=f"multipart/form-data; boundary={boundary}",
                                    timeout=60 + len(body) / 100_000)
        try:
            return json.loads(raw.decode("utf-8")) if raw else {}
        except ValueError:
            raise CLIError("Unexpected non-JSON response from the server", EXIT_API) from None

    def download_attachment(self, ref: str, thumb: bool = False) -> tuple[bytes, str, str]:
        """Fetch an attachment by id or URL; returns (bytes, content type, filename)."""
        aid = attachment_id(ref)
        path = f"/api/v1/attachments/{aid}" + ("/thumb" if thumb else "")
        raw, headers = self.request_bytes("GET", path, timeout=300)
        content_type = (headers.get("content-type") or "application/octet-stream").split(";")[0].strip()
        filename = filename_from_disposition(headers.get("content-disposition", "")) or aid
        return raw, content_type, filename

    # -- helpers -----------------------------------------------------------

    @staticmethod
    def ref_path(ref: str) -> str:
        return urllib.parse.quote(ref, safe="")

    def me(self, timeout: float = 15.0) -> dict:
        return self.request("GET", "/api/v1/me", timeout=timeout)

    _remote_known: bool | None = None

    def remote_mode(self) -> bool:
        """Whether the user is in remote mode. A network blip keeps the last
        known answer rather than flipping to off, which would cancel live waits."""
        try:
            me = self.me(timeout=10)
            self._remote_known = bool(((me.get("user") or {}).get("settings") or {}).get("remote_mode"))
        except CLIError:
            if self._remote_known is None:
                return False
        return self._remote_known

    def update_settings(self, **fields) -> dict:
        return self.request("PATCH", "/api/v1/settings", body=fields).get("settings", {})

    def create_thread(self, external_id: str | None = None, title: str = "", agent: str = "",
                      meta: dict | None = None) -> dict:
        body: dict = {}
        if external_id:
            body["external_id"] = external_id
        if title:
            body["title"] = title
        if agent:
            body["agent"] = agent
        if meta:
            body["meta"] = meta
        return self.request("POST", "/api/v1/threads", body=body)

    def delete_message(self, message_id: str) -> dict:
        return self.request("DELETE", f"/api/v1/messages/{urllib.parse.quote(message_id, safe='')}")

    def get_thread(self, ref: str) -> dict:
        return self.request("GET", f"/api/v1/threads/{self.ref_path(ref)}").get("thread", {})

    def set_activity(self, ref: str, text: str, *, kind: str | None = None, ttl: int | None = None,
                     seq: int | None = None, title: str = "", agent: str = "") -> dict:
        """Set the thread's live status line; an empty text clears it. The
        thread must exist: an `ext:` reference is created first when it is
        missing (so `finalechat status` works before the first message)."""
        body: dict = {"text": text}
        if kind:
            body["kind"] = kind
        if ttl:
            body["ttl_seconds"] = int(ttl)
        if seq:
            body["seq"] = int(seq)
        path = f"/api/v1/threads/{self.ref_path(ref)}/activity"
        try:
            return self.request("POST", path, body=body, timeout=10, retries=0)
        except APIError as err:
            if err.status != 404 or not ref.startswith("ext:"):
                raise
            self.create_thread(ref[4:], title=title, agent=agent)
            return self.request("POST", path, body=body, timeout=10, retries=0)

    def clear_activity(self, ref: str, seq: int | None = None) -> dict:
        params = {"seq": seq} if seq else None
        return self.request("DELETE", f"/api/v1/threads/{self.ref_path(ref)}/activity", params=params, timeout=10)

    def list_threads(self, archived: bool = False, limit: int = 50, query: str | None = None) -> list:
        params = {"limit": limit, "q": query}
        if archived:
            params["archived"] = "true"
        return self.request("GET", "/api/v1/threads", params=params).get("threads", [])

    def post_message(self, ref: str, body: str, *, sender: str | None = None, important: bool = False,
                     notify: bool | None = None, fmt: str = "markdown", meta: dict | None = None,
                     title: str = "", agent: str = "", files: list | None = None,
                     client_key: str | None = None) -> dict:
        """Post a message; with `files` (list of (filename, content_type, bytes)) it is one multipart request.
        A `client_key` makes the post safe to retry (the server dedupes it)."""
        payload: dict = {"body": body, "format": fmt, "importance": "important" if important else "normal",
                         "client_key": client_key or secrets.token_hex(16)}
        if sender:
            payload["sender"] = sender
        if notify is not None:
            payload["notify"] = notify
        if meta:
            payload["meta"] = meta
        if title:
            payload["title"] = title
        if agent:
            payload["agent"] = agent
        path = f"/api/v1/threads/{self.ref_path(ref)}/messages"
        if files:
            fields = dict(payload)
            if "meta" in fields:
                fields["meta"] = json.dumps(fields["meta"])
            if "notify" in fields:
                fields["notify"] = "true" if fields["notify"] else "false"
            return self.post_multipart(path, fields, files)
        return self.request("POST", path, body=payload)

    def list_messages(self, ref: str, *, after: str | None = None, before: str | None = None,
                      limit: int | None = None, wait: int | None = None, sender: str | None = None,
                      after_time: str | None = None) -> dict:
        params = {"after": after, "before": before, "limit": limit, "sender": sender, "after_time": after_time}
        timeout = 15.0
        if wait:
            params["wait"] = wait
            timeout = wait + 30
        return self.request("GET", f"/api/v1/threads/{self.ref_path(ref)}/messages", params=params, timeout=timeout)

    def ask(self, ref: str, prompt: str, options: list, *, multi: bool = False, freeform: bool = True,
            timeout_seconds: int | None = None, meta: dict | None = None, title: str = "", agent: str = "") -> dict:
        payload: dict = {"prompt": prompt, "options": options, "allow_freeform": freeform, "multi_select": multi,
                         "client_key": secrets.token_hex(16)}
        if timeout_seconds:
            payload["timeout_seconds"] = timeout_seconds
        if meta:
            payload["meta"] = meta
        if title:
            payload["title"] = title
        if agent:
            payload["agent"] = agent
        return self.request("POST", f"/api/v1/threads/{self.ref_path(ref)}/questions", body=payload)

    def get_question(self, qid: str, wait: int | None = None) -> dict:
        params = {"wait": wait} if wait else None
        timeout = (wait + 30) if wait else 15.0
        return self.request("GET", f"/api/v1/questions/{qid}", params=params, timeout=timeout).get("question", {})

    def cancel_question(self, qid: str) -> dict:
        return self.request("POST", f"/api/v1/questions/{qid}/cancel", body={}).get("question", {})


# --------------------------------------------------------------------------- #
# Waiting primitives
# --------------------------------------------------------------------------- #


def wait_for_answer(client: Client, qid: str, total: int, keep_going=None) -> dict:
    """Poll a question until it leaves the pending state or `total` seconds pass.

    `keep_going` is an optional callable checked between polls; returning False
    stops early (used by hooks when remote mode is switched off).
    """
    deadline = time.monotonic() + max(0, total)
    question = client.get_question(qid)
    while question.get("status") == "pending":
        remaining = int(deadline - time.monotonic())
        if remaining <= 0:
            break
        if keep_going is not None and not keep_going():
            break
        question = client.get_question(qid, wait=min(POLL_CHUNK, max(1, remaining)))
    return question


def latest_message_id(client: Client, ref: str) -> str | None:
    msgs = client.list_messages(ref, limit=1).get("messages") or []
    return msgs[-1]["id"] if msgs else None


def wait_for_reply(client: Client, ref: str, after: str | None, total: int, keep_going=None) -> dict | None:
    """Block until the next user message after `after` arrives, or time out."""
    deadline = time.monotonic() + max(0, total)
    # Without a message to anchor on, the server anchors on its clock and
    # hands the instant back as waited_from; carrying it forward means a reply
    # that lands between two chunks is never skipped.
    after_time: str | None = None
    while True:
        remaining = int(deadline - time.monotonic())
        if remaining <= 0:
            return None
        if keep_going is not None and not keep_going():
            return None
        # Shorter chunks while a hook is waiting so a remote-mode switch is noticed quickly.
        chunk = HOOK_WAIT_CHUNK if keep_going is not None else 60
        resp = client.list_messages(ref, after=after, after_time=None if after else after_time, sender="user",
                                    wait=min(chunk, remaining))
        if after is None and resp.get("waited_from"):
            after_time = str(resp["waited_from"])
        msgs = resp.get("messages") or []
        # A "user" message posted by an agent (a mirrored terminal prompt) is
        # not the user replying from the app, and a tombstone is nothing at
        # all; keep waiting past both.
        skip = [m for m in msgs if m.get("origin") == "token" or m.get("deleted")]
        if skip and len(skip) == len(msgs):
            after = msgs[-1].get("id") or after
            continue
        msgs = [m for m in msgs if m.get("origin") != "token" and not m.get("deleted")]
        if msgs:
            return msgs[0]


def format_answer(question: dict) -> str:
    answer = question.get("answer") or {}
    lines = []
    selected = answer.get("selected") or []
    if selected:
        lines.append(", ".join(selected))
    text = (answer.get("text") or "").strip()
    if text:
        lines.append(text)
    return "\n".join(lines)


def answer_summary(question: dict) -> str:
    """One-line rendering used in hook and MCP replies."""
    answer = question.get("answer") or {}
    selected = answer.get("selected") or []
    text = (answer.get("text") or "").strip()
    parts = []
    if selected:
        parts.append(", ".join(selected))
    if text:
        parts.append(text)
    return " — ".join(parts) if parts else "(no answer)"


# --------------------------------------------------------------------------- #
# Attachments
# --------------------------------------------------------------------------- #

UUID_RE = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}", re.IGNORECASE)


def attachment_id(ref: str) -> str:
    """Accept an attachment id, a relative API path, or an absolute URL."""
    ref = (ref or "").strip()
    match = UUID_RE.search(ref)
    if not match or ("/" in ref and "/attachments/" not in ref):
        raise CLIError(f"Not an attachment id or URL: {ref!r}")
    return match.group(0).lower()


def filename_from_disposition(value: str) -> str:
    match = re.search(r"filename\*=UTF-8\'\'([^;]+)", value)
    if match:
        return urllib.parse.unquote(match.group(1)).strip()
    match = re.search(r'filename="((?:[^"\\]|\\.)*)"', value)
    if match:
        return match.group(1).replace('\\"', '"').strip()
    match = re.search(r"filename=([^;]+)", value)
    if match:
        return match.group(1).strip().strip('"')
    return ""


def human_size(size) -> str:
    try:
        n = float(size)
    except (TypeError, ValueError):
        return "?"
    for unit in ("B", "KB", "MB", "GB"):
        if n < 1024 or unit == "GB":
            return f"{int(n)} {unit}" if unit == "B" else f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} GB"


def attachment_line(client: Client, att: dict) -> str:
    url = att.get("url") or ""
    if url.startswith("/"):
        url = client.base_url + url
    return f"📎 {att.get('filename') or att.get('id')} ({att.get('content_type', '?')}, {human_size(att.get('size'))}) {url}"


def message_attachments(message: dict) -> list:
    return [a for a in (message.get("attachments") or []) if isinstance(a, dict)]


def attachment_hint(message: dict) -> str:
    """Sentence telling an agent how to get at the files on a reply."""
    atts = message_attachments(message)
    if not atts:
        return ""
    descs = []
    for a in atts:
        name = a.get("filename") or a.get("id")
        descs.append(f"{name} ({a.get('content_type', '?')})")
    first = atts[0]
    first_name = os.path.basename(first.get("filename") or "attachment") or "attachment"
    noun = "attachment" if len(atts) == 1 else "attachments"
    target = shlex.quote(os.path.join("/tmp", first_name))
    return (f" The reply includes {len(atts)} {noun}: " + ", ".join(descs) +
            f" — download with `finalechat fetch {first.get('id')} -o {target}`"
            + (" (one fetch per id)" if len(atts) > 1 else "") + " and read the file to view it.")


def read_local_files(paths: list) -> list:
    """Load files for upload as (filename, content_type, bytes), enforcing limits up front."""
    if len(paths) > MAX_ATTACHMENTS:
        raise CLIError(f"At most {MAX_ATTACHMENTS} files per message.")
    files = []
    for raw in paths:
        path = os.path.expanduser(str(raw))
        if not os.path.isfile(path):
            raise CLIError(f"No such file: {path}")
        size = os.path.getsize(path)
        if size > MAX_ATTACHMENT_BYTES:
            raise CLIError(f"{path} is {human_size(size)} ({size} bytes); attachments must be at most 10 MB ({MAX_ATTACHMENT_BYTES} bytes).")
        if size == 0:
            raise CLIError(f"{path} is empty.")
        content_type = mimetypes.guess_type(path)[0] or "application/octet-stream"
        with open(path, "rb") as fh:
            files.append((os.path.basename(path), content_type, fh.read()))
    return files


def unique_path(path: str) -> str:
    """Return `path`, or a numbered variant if it already exists."""
    if not os.path.exists(path):
        return path
    stem, ext = os.path.splitext(path)
    for i in range(1, 10_000):
        candidate = f"{stem}-{i}{ext}"
        if not os.path.exists(candidate):
            return candidate
    raise CLIError(f"Could not find a free filename near {path}")


def save_attachment(client: Client, ref: str, out: str | None) -> str:
    data, _content_type, filename = client.download_attachment(ref)
    if out:
        target = os.path.expanduser(out)
        if os.path.isdir(target):
            safe = os.path.basename(filename)
            if safe in ("", ".", ".."):
                safe = attachment_id(ref)
            target = os.path.join(target, safe)
    else:
        target = os.path.join(os.getcwd(), os.path.basename(filename) or attachment_id(ref))
    target = unique_path(target)
    parent = os.path.dirname(target)
    if parent:
        os.makedirs(parent, exist_ok=True)
    with open(target, "wb") as fh:
        fh.write(data)
    return target


# --------------------------------------------------------------------------- #
# Thread resolution
# --------------------------------------------------------------------------- #


def hostname() -> str:
    try:
        return socket.gethostname().split(".")[0] or "host"
    except OSError:
        return "host"


def cwd_key(path: str) -> str:
    return hashlib.sha1(os.path.abspath(path).encode("utf-8")).hexdigest()


def _load_sessions(target: Path) -> dict:
    """The per-directory session map: {session_id: {external_id, pid, updated_at}}."""
    try:
        with target.open() as fh:
            data = json.load(fh)
    except (OSError, ValueError):
        return {}
    sessions = data.get("sessions") if isinstance(data, dict) else None
    if isinstance(sessions, dict):
        return sessions
    # An older single-session pointer file.
    if isinstance(data, dict) and data.get("external_id") and data.get("session_id"):
        return {str(data["session_id"]): {"external_id": data["external_id"], "pid": 0, "updated_at": data.get("updated_at", 0)}}
    return {}


def _save_sessions(target: Path, sessions: dict, cwd: str) -> None:
    BY_CWD_DIR.mkdir(parents=True, exist_ok=True)
    tmp = target.with_suffix(".tmp")
    with tmp.open("w") as fh:
        json.dump({"cwd": os.path.abspath(cwd), "sessions": sessions}, fh)
    tmp.replace(target)


def _pid_alive(pid: int) -> bool:
    if pid <= 0:
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    except OSError:
        return False


def _ancestor_pids() -> set:
    """Every process above this one, so a CLI run from inside a Claude Code
    session can tell which session it belongs to."""
    pids: set = set()
    pid = os.getppid()
    for _ in range(64):
        if pid <= 1 or pid in pids:
            break
        pids.add(pid)
        parent = 0
        try:
            with open(f"/proc/{pid}/stat") as fh:
                stat = fh.read()
            parent = int(stat.rsplit(")", 1)[1].split()[1])
        except (OSError, ValueError, IndexError):
            try:
                out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)], capture_output=True, text=True, timeout=2).stdout
                parent = int(out.strip() or 0)
            except (OSError, ValueError, subprocess.SubprocessError):
                parent = 0
        pid = parent
    return pids


def read_by_cwd_pointer(path: str | None = None) -> dict | None:
    """The thread the Claude Code session that spawned this process is using,
    or, when no ancestor is a known session, the most recently active live
    session in this directory. Two sessions in one directory therefore stop
    posting into each other's threads."""
    target = BY_CWD_DIR / f"{cwd_key(path or os.getcwd())}.json"
    sessions = _load_sessions(target)
    if not sessions:
        return None
    now = time.time()
    live = {sid: s for sid, s in sessions.items()
            if isinstance(s, dict) and s.get("external_id") and now - float(s.get("updated_at") or 0) <= BY_CWD_MAX_AGE
            and (not s.get("pid") or _pid_alive(int(s.get("pid") or 0)))}
    if len(live) != len(sessions):
        try:
            _save_sessions(target, live, path or os.getcwd())
        except OSError:
            pass
    if not live:
        return None
    ancestors = _ancestor_pids()
    for sid, s in live.items():
        if s.get("pid") and int(s["pid"]) in ancestors:
            return {"external_id": s["external_id"], "session_id": sid}
    sid, s = max(live.items(), key=lambda kv: float(kv[1].get("updated_at") or 0))
    return {"external_id": s["external_id"], "session_id": sid}


def clear_by_cwd_pointer(cwd: str, session_id: str) -> None:
    """Forget a session when it ends."""
    target = BY_CWD_DIR / f"{cwd_key(cwd)}.json"
    sessions = _load_sessions(target)
    if session_id in sessions:
        sessions.pop(session_id, None)
        try:
            if sessions:
                _save_sessions(target, sessions, cwd)
            else:
                target.unlink()
        except OSError:
            pass


def write_by_cwd_pointer(cwd: str, external_id: str, session_id: str) -> None:
    """Record (or refresh) a session for this directory. The hook's parent is
    the Claude Code process, which is what later CLI runs find in their own
    ancestry."""
    target = BY_CWD_DIR / f"{cwd_key(cwd)}.json"
    sessions = _load_sessions(target)
    entry = sessions.get(session_id) or {}
    entry.update({"external_id": external_id, "updated_at": time.time()})
    if not entry.get("pid"):
        entry["pid"] = os.getppid()
    sessions[session_id] = entry
    _save_sessions(target, sessions, cwd)


class ThreadTarget:
    """A thread reference plus the naming to use if it has to be created."""

    def __init__(self, ref: str, title: str = "", agent: str = ""):
        self.ref = ref
        self.title = title
        self.agent = agent

    def __str__(self) -> str:
        return self.ref


def default_agent(fallback: str = "Terminal") -> str:
    return os.environ.get("FINALECHAT_AGENT") or fallback


def resolve_target(explicit: str | None = None, title: str | None = None, agent: str | None = None,
                   fallback_agent: str = "Terminal", fallback_prefix: str = "cli") -> ThreadTarget:
    cwd = os.getcwd()
    if explicit:
        return ThreadTarget(explicit, title or "", agent or "")
    env = os.environ.get("FINALECHAT_THREAD")
    if env:
        return ThreadTarget(env, title or "", agent or "")
    pointer = read_by_cwd_pointer(cwd)
    if pointer:
        return ThreadTarget("ext:" + pointer["external_id"], title or "", agent or "")
    ext = f"ext:{fallback_prefix}:{hostname()}:{os.path.abspath(cwd)}"
    return ThreadTarget(ext, title or os.path.basename(os.path.abspath(cwd)) or "Terminal",
                        agent or default_agent(fallback_agent))


