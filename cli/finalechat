class Formatter(argparse.RawDescriptionHelpFormatter):
    def __init__(self, prog):
        super().__init__(prog, max_help_position=28, width=min(100, shutil.get_terminal_size((100, 20)).columns))


def add_thread_args(parser: argparse.ArgumentParser, naming: bool = True) -> None:
    parser.add_argument("-t", "--thread", metavar="REF",
                        help="thread id or ext:<external id> (default: $FINALECHAT_THREAD, "
                             "the current Claude Code session, or one thread per directory)")
    if naming:
        parser.add_argument("--title", help="title for the thread if it has to be created")
        parser.add_argument("--agent", help="agent name for the thread if it has to be created "
                                            "(default: $FINALECHAT_AGENT or Terminal)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="finalechat",
        formatter_class=Formatter,
        description=(
            "Message the human from your agent, and get answers back.\n\n"
            "Finalechat delivers what an agent says to the user's phone as a threaded\n"
            "chat, and lets the agent ask questions the user answers with a tap."
        ),
        epilog=(
            "examples:\n"
            "  finalechat login                       sign in with a token from Settings → Agents\n"
            "  finalechat say \"Tests are green\"        post a message to this directory's thread\n"
            "  finalechat say --important \"Found it!\"  post and push a notification\n"
            "  finalechat say -f shot.png             attach a screenshot\n"
            "  finalechat status \"Running tests…\"      live status line; lapses on its own\n"
            "  finalechat fetch <id> -o /tmp/x.png    download a file the human sent\n"
            "  finalechat ask \"Deploy?\" -o Yes -o No   ask, block until answered, print the answer\n"
            "  finalechat wait                        block until the human replies\n"
            "  finalechat install claude-code         mirror Claude Code sessions to your phone\n"
            "  finalechat remote on                   make sessions wait for phone replies\n\n"
            "environment:\n"
            "  FINALECHAT_TOKEN   API token (overrides the saved login)\n"
            "  FINALECHAT_URL     server origin (default https://www.finalechat.com)\n"
            "  FINALECHAT_THREAD  default thread ref for this shell\n"
            "  FINALECHAT_AGENT   agent name used when a thread is created\n\n"
            "exit codes: 0 ok · 1 usage · 2 API/network error · 3 timed out · 4 question cancelled/expired\n"
            "docs: https://www.finalechat.com/api/"
        ),
    )
    parser.add_argument("--version", action="version", version=f"finalechat {VERSION}")
    parser.add_argument("--url", metavar="URL", help="server origin (default: $FINALECHAT_URL or saved login)")
    parser.add_argument("--token", metavar="TOKEN", help="API token (default: $FINALECHAT_TOKEN or saved login)")
    sub = parser.add_subparsers(dest="command", metavar="<command>")
    sub.required = True

    p = sub.add_parser("login", help="save an API token", formatter_class=Formatter,
                       description="Verify an API token and save it to ~/.config/finalechat/config.json.")
    p.add_argument("token_arg", nargs="?", metavar="TOKEN", help="token from Settings → Agents (prompted if omitted)")
    p.set_defaults(func=cmd_login)

    p = sub.add_parser("logout", help="forget the saved token", formatter_class=Formatter)
    p.set_defaults(func=cmd_logout)

    p = sub.add_parser("whoami", help="show the signed-in account", formatter_class=Formatter)
    p.add_argument("--json", action="store_true", help="print the raw /me response")
    p.set_defaults(func=cmd_whoami)

    p = sub.add_parser("threads", help="list threads", formatter_class=Formatter)
    p.add_argument("--archived", action="store_true", help="list archived threads instead")
    p.add_argument("--limit", type=int, default=50, metavar="N", help="max threads (default 50)")
    p.add_argument("--json", action="store_true", help="print JSON")
    p.set_defaults(func=cmd_threads)

    p = sub.add_parser("read", help="print a thread's messages", formatter_class=Formatter)
    p.add_argument("ref", nargs="?", metavar="REF", help="thread id or ext:<external id>")
    add_thread_args(p, naming=False)
    p.add_argument("--limit", type=int, default=50, metavar="N", help="most recent N messages (default 50)")
    p.add_argument("--json", action="store_true", help="print JSON")
    p.set_defaults(func=cmd_read)

    p = sub.add_parser("say", help="send a message (optionally with files)", formatter_class=Formatter,
                       description="Send a message to the human. Markdown by default. Reads stdin when no "
                                   "message is given (or when MESSAGE is -). Attach screenshots or files "
                                   "with -f.",
                       epilog="examples:\n  finalechat say \"Deployed v2\" --important\n"
                              "  finalechat say \"Staging after the deploy\" -f /tmp/staging.png")
    p.add_argument("message", nargs="*", metavar="MESSAGE", help="message text (joined with spaces)")
    add_thread_args(p)
    p.add_argument("-f", "--file", action="append", metavar="PATH",
                   help="attach a file (repeatable, up to 8, 10 MB each); the message text becomes optional")
    p.add_argument("--important", action="store_true", help="mark important and push a notification")
    notify = p.add_mutually_exclusive_group()
    notify.add_argument("--notify", dest="notify", action="store_true", default=None,
                        help="push a notification even if not important")
    notify.add_argument("--no-notify", dest="notify", action="store_false",
                        help="never push, even if important")
    p.add_argument("--text", action="store_true", help="send as plain text instead of markdown")
    p.add_argument("--json", action="store_true", help="print the created message as JSON")
    p.set_defaults(func=cmd_say)

    p = sub.add_parser("delete", help="remove a message you should not have sent", formatter_class=Formatter,
                       description="Delete a message and its attachments for good, for example after posting a secret. "
                                   "Message ids are printed by say, read and wait.")
    p.add_argument("message_id", metavar="MESSAGE_ID")
    p.add_argument("--json", action="store_true", help="print the response as JSON")
    p.set_defaults(func=cmd_delete)

    p = sub.add_parser("status", help="show what you are doing (a live status line)", formatter_class=Formatter,
                       description="Set the thread's live status line: what you are doing right now. The app "
                                   "shows it as a typing indicator with a timer. It never notifies, is not part "
                                   "of the transcript, lapses after --ttl seconds (default 45) unless set again, "
                                   "and is dropped by your next message. With no TEXT, prints the current status.",
                       epilog="examples:\n  finalechat status \"Running the test suite…\" --ttl 120\n"
                              "  finalechat status \"Reading the migration files\" --kind tool\n"
                              "  finalechat status --clear")
    p.add_argument("text", nargs="*", metavar="TEXT", help="the status line (joined with spaces)")
    add_thread_args(p)
    p.add_argument("--kind", choices=["thinking", "working", "typing", "waiting", "tool"],
                   help="what sort of activity (default working)")
    p.add_argument("--ttl", type=int, metavar="SECS", help="seconds until it lapses unless set again (default 45, max 600)")
    p.add_argument("--clear", action="store_true", help="drop the status now")
    p.add_argument("--seq", type=int, metavar="N", help="ordering for concurrent writers: a status with a lower N than the live one is ignored")
    p.add_argument("--json", action="store_true", help="print the thread as JSON")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("ask", help="ask a question and wait for the answer", formatter_class=Formatter,
                       description="Ask the human a question (multiple choice, free-form, or both) and block "
                                   "until they answer. Prints the chosen labels on the first line and any "
                                   "typed text after that.",
                       epilog="example:\n  finalechat ask \"Which env?\" -o \"staging::Safe\" -o prod --wait 900")
    p.add_argument("prompt", metavar="PROMPT", help="the question (or - to read from stdin)")
    p.add_argument("-o", "--option", action="append", metavar="LABEL[::DESCRIPTION]",
                   help="an option to offer (repeatable)")
    p.add_argument("--multi", action="store_true", help="allow choosing several options")
    p.add_argument("--no-freeform", action="store_true", help="options only, no typed answer")
    p.add_argument("--timeout", type=int, metavar="SECS",
                   help="expire the question server-side after SECS")
    p.add_argument("--wait", type=int, default=1800, metavar="SECS",
                   help="how long to block for an answer (default 1800; 0 = return immediately)")
    add_thread_args(p)
    p.add_argument("--json", action="store_true", help="print the question as JSON")
    p.set_defaults(func=cmd_ask)

    p = sub.add_parser("fetch", help="download an attachment the human sent", formatter_class=Formatter,
                       description="Download an attachment (by id or Finalechat URL) to a local file and print "
                                   "the path. Existing files are never overwritten; a numbered name is used.")
    p.add_argument("attachment", metavar="ATTACHMENT", help="attachment id or URL (as printed by read/wait)")
    p.add_argument("-o", "--output", metavar="PATH", help="file or directory to save into (default: ./<filename>)")
    p.set_defaults(func=cmd_fetch)

    p = sub.add_parser("wait-answer", help="resume waiting for a question's answer", formatter_class=Formatter)
    p.add_argument("question_id", metavar="QUESTION_ID")
    p.add_argument("--wait", type=int, default=1800, metavar="SECS", help="how long to block (default 1800)")
    p.add_argument("--json", action="store_true", help="print the question as JSON")
    p.set_defaults(func=cmd_wait_answer)

    p = sub.add_parser("wait", help="wait for the human's next message", formatter_class=Formatter,
                       description="Block until the human sends a new message in the thread, then print it.")
    add_thread_args(p, naming=False)
    p.add_argument("--after", metavar="MESSAGE_ID", help="only messages after this id (default: the latest)")
    p.add_argument("--timeout", type=int, default=1800, metavar="SECS", help="how long to block (default 1800)")
    p.add_argument("--json", action="store_true", help="print the message as JSON")
    p.set_defaults(func=cmd_wait)

    p = sub.add_parser("remote", help="toggle remote mode (sessions wait for phone replies)",
                       formatter_class=Formatter,
                       description="When remote mode is on, Claude Code hooks block waiting for your replies "
                                   "and answers from the app instead of falling through to the terminal.")
    p.add_argument("action", nargs="?", choices=["on", "off", "status"], help="default: status")
    p.set_defaults(func=cmd_remote)

    p = sub.add_parser("install", help="integrate with an agent harness (claude-code)", formatter_class=Formatter,
                       description="Install Finalechat hooks (and the MCP server) into Claude Code so every "
                                   "session is mirrored to your phone.")
    p.add_argument("target", choices=["claude-code"])
    p.add_argument("--no-mcp", action="store_true", help="skip registering the MCP server")
    p.add_argument("--settings", default="~/.claude/settings.json", metavar="PATH",
                   help="Claude Code settings file (default ~/.claude/settings.json)")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("uninstall", help="remove the integration", formatter_class=Formatter)
    p.add_argument("target", choices=["claude-code"])
    p.add_argument("--no-mcp", action="store_true", help="leave the MCP server registered")
    p.add_argument("--settings", default="~/.claude/settings.json", metavar="PATH")
    p.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("hook", help="handle a harness hook event (reads JSON on stdin)", formatter_class=Formatter)
    p.add_argument("target", choices=["claude-code"])
    p.set_defaults(func=cmd_hook)

    p = sub.add_parser("selftest", help=argparse.SUPPRESS, formatter_class=Formatter)
    p.set_defaults(func=cmd_selftest)

    p = sub.add_parser("mcp", help="run the MCP server over stdio", formatter_class=Formatter,
                       description="Model Context Protocol server exposing finalechat_send, finalechat_status, "
                                   "finalechat_ask, finalechat_wait_for_reply, finalechat_read, "
                                   "finalechat_view_attachment and finalechat_fetch_attachment.")
    p.set_defaults(func=cmd_mcp)

    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args) or 0)
    except KeyboardInterrupt:
        print("interrupted", file=sys.stderr)
        return 130
    except BrokenPipeError:
        return EXIT_OK
    except APIError as err:
        print(f"finalechat: {err} [{err.code}]", file=sys.stderr)
        return err.exit_code
    except CLIError as err:
        print(f"finalechat: {err}", file=sys.stderr)
        return err.exit_code


if __name__ == "__main__":
    sys.exit(main())
