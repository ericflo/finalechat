    p.add_argument("--seq", type=int, metavar="N", help="ordering for concurrent writers (default: the clock, in nanoseconds): a status "
                                                        "with a lower N than the live one is ignored; also sequences --clear")
    p.add_argument("--json", action="store_true", help="print the thread as JSON")
    p.set_defaults(func=cmd_status)

    p = sub.add_parser("ask", help="ask a question and wait for the answer", formatter_class=Formatter,
                       description="Ask the human a question (multiple choice, free-form, or both) and block "
                                   "until they answer. Prints the chosen labels on the first line and any "
                                   "typed text after that.",
                       epilog="example:\n  finalechat ask \"Which env?\" -o \"staging::Safe\" -o prod --wait 900")
    p.add_argument("prompt", metavar="PROMPT", help="the question (or - to read from stdin)")
    p.add_argument("-o", "--option", action="append", metavar="LABEL[::DESCRIPTION]",
                   help="an option to offer (repeatable)")
    p.add_argument("--multi", action="store_true", help="allow choosing several options")
    p.add_argument("--no-freeform", action="store_true", help="options only, no typed answer")
    p.add_argument("--timeout", type=int, metavar="SECS",
                   help="expire the question server-side after SECS")
    p.add_argument("--wait", type=int, default=1800, metavar="SECS",
                   help="how long to block for an answer (default 1800; 0 = return immediately)")
    add_thread_args(p)
    p.add_argument("--json", action="store_true", help="print the question as JSON")
    p.set_defaults(func=cmd_ask)

    p = sub.add_parser("fetch", help="download an attachment the human sent", formatter_class=Formatter,
                       description="Download an attachment (by id or Finalechat URL) to a local file and print "
                                   "the path. Existing files are never overwritten; a numbered name is used.")
    p.add_argument("attachment", metavar="ATTACHMENT", help="attachment id or URL (as printed by read/wait)")
    p.add_argument("-o", "--output", metavar="PATH", help="file or directory to save into (default: ./<filename>)")
    p.set_defaults(func=cmd_fetch)

    p = sub.add_parser("wait-answer", help="resume waiting for a question's answer", formatter_class=Formatter)
    p.add_argument("question_id", metavar="QUESTION_ID")
    p.add_argument("--wait", type=int, default=1800, metavar="SECS", help="how long to block (default 1800)")
    p.add_argument("--json", action="store_true", help="print the question as JSON")
    p.set_defaults(func=cmd_wait_answer)

    p = sub.add_parser("wait", help="wait for the human's next message", formatter_class=Formatter,
                       description="Block until the human sends a new message in the thread, then print it.")
    add_thread_args(p, naming=False)
    p.add_argument("--after", metavar="MESSAGE_ID", help="only messages after this id (default: the latest)")
    p.add_argument("--timeout", type=int, default=1800, metavar="SECS", help="how long to block (default 1800)")
    p.add_argument("--json", action="store_true", help="print the message as JSON")
    p.set_defaults(func=cmd_wait)

    p = sub.add_parser("remote", help="toggle remote mode (sessions wait for phone replies)",
                       formatter_class=Formatter,
                       description="When remote mode is on, Claude Code hooks block waiting for your replies "
                                   "and answers from the app instead of falling through to the terminal.")
    p.add_argument("action", nargs="?", choices=["on", "off", "status"], help="default: status")
    p.set_defaults(func=cmd_remote)

    p = sub.add_parser("install", help="integrate with Claude Code or Codex", formatter_class=Formatter,
                       description="Install Claude Code hooks or Codex MCP, with optional native session artifacts.")
    p.add_argument("target", choices=["claude-code", "codex"])
    p.add_argument("--no-mcp", action="store_true", help="skip registering the MCP server")
    p.add_argument("--settings", default="~/.claude/settings.json", metavar="PATH",
                   help="Claude Code settings file (default ~/.claude/settings.json)")
    p.add_argument("--project", default=".", help="project for optional artifact publication")
    p.add_argument("--artifacts", action="store_true", help="opt this project into proactive native session archives")
    p.set_defaults(func=cmd_install)

    p = sub.add_parser("uninstall", help="remove the integration", formatter_class=Formatter)
    p.add_argument("target", choices=["claude-code", "codex"])
    p.add_argument("--no-mcp", action="store_true", help="leave the MCP server registered")
    p.add_argument("--settings", default="~/.claude/settings.json", metavar="PATH")
    p.add_argument("--project", default=".", help="project whose companion should stop")
    p.set_defaults(func=cmd_uninstall)

    p = sub.add_parser("hook", help="handle a harness hook event (reads JSON on stdin)", formatter_class=Formatter)
    p.add_argument("target", choices=["claude-code"])
    p.set_defaults(func=cmd_hook)

    p = sub.add_parser("selftest", help=argparse.SUPPRESS, formatter_class=Formatter)
    p.set_defaults(func=cmd_selftest)

    p = sub.add_parser("mcp", help="run the MCP server over stdio", formatter_class=Formatter,
                       description="Model Context Protocol server exposing finalechat_send, finalechat_status, "
                                   "finalechat_ask, finalechat_wait_for_reply, finalechat_read, "
                                   "finalechat_view_attachment and finalechat_fetch_attachment.")
    p.set_defaults(func=cmd_mcp)

    add_integration_parsers(sub)
    return parser


def main(argv: list[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    try:
        return int(args.func(args) or 0)
    except KeyboardInterrupt:
        print("interrupted", file=sys.stderr)
        return 130
    except BrokenPipeError:
        return EXIT_OK
    except APIError as err:
        print(f"finalechat: {err} [{err.code}]", file=sys.stderr)
        return err.exit_code
    except CLIError as err:
        print(f"finalechat: {err}", file=sys.stderr)
        return err.exit_code
    except (OSError, ValueError) as err:
        print(f"finalechat: local data or filesystem error ({type(err).__name__}); inspect the selected paths and configuration.", file=sys.stderr)
        return EXIT_USAGE


if __name__ == "__main__":
    sys.exit(main())
