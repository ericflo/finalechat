def hook_log(message: str) -> None:
    try:
        CACHE_DIR.mkdir(parents=True, exist_ok=True)
        with HOOK_LOG.open("a") as fh:
            fh.write(f"{datetime.now().isoformat(timespec='seconds')} {message}\n")
    except OSError:
        pass


def session_state_path(session_id: str) -> Path:
    safe = "".join(ch if ch.isalnum() or ch in "-_" else "_" for ch in session_id) or "unknown"
    return SESSIONS_DIR / f"{safe}.json"


def load_session_state(session_id: str) -> dict:
    try:
        with session_state_path(session_id).open() as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_session_state(session_id: str, state: dict) -> None:
    SESSIONS_DIR.mkdir(parents=True, exist_ok=True)
    path = session_state_path(session_id)
    tmp = path.with_suffix(".tmp")
    with tmp.open("w") as fh:
        json.dump(state, fh)
    tmp.replace(path)


def last_assistant_text(transcript_path: str) -> tuple[str | None, str]:
    """Return (uuid, text) of the last assistant entry that contains text."""
    found_uuid, found_text = None, ""
    try:
        with open(transcript_path, encoding="utf-8", errors="replace") as fh:
            for line in fh:
                line = line.strip()
                if not line:
                    continue
                try:
                    entry = json.loads(line)
                except ValueError:
                    continue
                if not isinstance(entry, dict) or entry.get("type") != "assistant":
                    continue
                if entry.get("isSidechain"):
                    continue
                message = entry.get("message") or {}
                content = message.get("content")
                texts = []
                if isinstance(content, str):
                    texts.append(content)
                elif isinstance(content, list):
                    for block in content:
                        if isinstance(block, dict) and block.get("type") == "text":
                            text = block.get("text")
                            if isinstance(text, str) and text.strip():
                                texts.append(text)
                if texts:
                    found_uuid = entry.get("uuid") or found_uuid
                    found_text = "\n\n".join(t.strip() for t in texts)
    except OSError as err:
        hook_log(f"transcript unreadable: {err}")
    return found_uuid, found_text


def env_seconds(name: str, default: int) -> int:
    try:
        return max(0, int(os.environ.get(name, default)))
    except ValueError:
        return default


def status_enabled() -> bool:
    return os.environ.get("FINALECHAT_STATUS", "").strip().lower() not in ("0", "off", "false", "no")


def spawn_status(ref: str, text: str, kind: str, ttl: int, title: str, agent: str) -> None:
    """Set the thread's status line from a detached process, so a hook
    returns to Claude Code at once instead of waiting on the network."""
    text = truncate(" ".join(text.split()), 200)
    if not text or not status_enabled():
        return
    # The sequence number is taken now, so a slow earlier write can never
    # overtake a newer one on the server.
    argv = [sys.executable, cli_path(), "status", text, "--kind", kind, "--ttl", str(ttl), "-t", ref,
            "--seq", str(time.time_ns())]
    if title:
        argv += ["--title", title]
    if agent:
        argv += ["--agent", agent]
    try:
        subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                         start_new_session=True, close_fds=True)
    except OSError as err:
        hook_log(f"status spawn failed: {err}")


def clear_status(client: Client, ref: str) -> None:
    if not status_enabled():
        return
    try:
        # Sequenced like the writes, so a status still in flight from an
        # earlier hook cannot come back after this clear.
        client.clear_activity(ref, seq=time.time_ns())
    except CLIError as err:
        hook_log(f"status clear failed: {err}")


# Each pattern keeps what identifies the secret (the header or variable name
# and its separator) and blanks the value. Names may carry the keyword
# anywhere (AWS_SECRET_ACCESS_KEY, DB_PASSWORD, --api-key); a separator is
# required so `grep secret path` and `kubectl get secret name` stay readable.
SECRET_PATTERNS = [
    (re.compile(r"(?i)\b(bearer\s+)[A-Za-z0-9._~+/=-]{8,}"), r"\1••••"),
    (re.compile(r"(?i)(?<![A-Za-z0-9])([A-Za-z0-9_-]*(?:authorization|token|api[_-]?key|secret|passw(?:or)?d|pwd|credential)[A-Za-z0-9_-]*\s*[=:]\s*)['\"]?(?!bearer\b)[^\s'\"]{4,}"), r"\1••••"),
    (re.compile(r"\b(?:fc|sk|ghp|gho|ghs|glpat)[-_][A-Za-z0-9_-]{6,}|\bxox[abp]-[A-Za-z0-9-]{6,}|\bAKIA[0-9A-Z]{16}\b"), "••••"),
    (re.compile(r"://[^/\s:@]+:[^/\s@]+@"), "://••••@"),
    (re.compile(r"(?<==)['\"]?[A-Fa-f0-9]{32,}\b"), "••••"),
]


def redact_secrets(text: str) -> str:
    """Hide anything in a command line that looks like a credential before it
    is shown on the phone (and stored on the server)."""
    out = text
    for pat, repl in SECRET_PATTERNS:
        out = pat.sub(repl, out)
    return out


