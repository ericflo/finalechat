class Formatter(argparse.RawDescriptionHelpFormatter):
    def __init__(self, prog):
        super().__init__(prog, max_help_position=28, width=min(100, shutil.get_terminal_size((100, 20)).columns))


def add_thread_args(parser: argparse.ArgumentParser, naming: bool = True) -> None:
    parser.add_argument("-t", "--thread", metavar="REF",
                        help="thread id or ext:<external id> (default: $FINALECHAT_THREAD, "
                             "the current Claude Code session, or one thread per directory)")
    if naming:
        parser.add_argument("--title", help="title for the thread if it has to be created")
        parser.add_argument("--agent", help="agent name for the thread if it has to be created "
                                            "(default: $FINALECHAT_AGENT or Terminal)")


def build_parser() -> argparse.ArgumentParser:
    parser = argparse.ArgumentParser(
        prog="finalechat",
        formatter_class=Formatter,
        description=(
            "Message the human from your agent, and get answers back.\n\n"
            "Finalechat delivers what an agent says to the user's phone as a threaded\n"
            "chat, and lets the agent ask questions the user answers with a tap."
        ),
        epilog=(
            "examples:\n"
            "  finalechat login                       sign in with a token from Settings → Agents\n"
            "  finalechat say \"Tests are green\"        post a message to this directory's thread\n"
            "  finalechat say --important \"Found it!\"  post and push a notification\n"
            "  finalechat say -f shot.png             attach a screenshot\n"
            "  finalechat status \"Running tests…\"      live status line; lapses on its own\n"
            "  finalechat fetch <id> -o /tmp/x.png    download a file the human sent\n"
            "  finalechat ask \"Deploy?\" -o Yes -o No   ask, block until answered, print the answer\n"
            "  finalechat wait                        block until the human replies\n"
            "  finalechat install claude-code         mirror Claude Code sessions to your phone\n"
            "  finalechat remote on                   make sessions wait for phone replies\n\n"
            "environment:\n"
            "  FINALECHAT_TOKEN   API token (overrides the saved login)\n"
            "  FINALECHAT_URL     server origin (default https://www.finalechat.com)\n"
            "  FINALECHAT_THREAD  default thread ref for this shell\n"
            "  FINALECHAT_AGENT   agent name used when a thread is created\n\n"
            "exit codes: 0 ok · 1 usage · 2 API/network error · 3 timed out · 4 question cancelled/expired\n"
            "docs: https://www.finalechat.com/api/"
        ),
    )
    parser.add_argument("--version", action="version", version=f"finalechat {VERSION}")
    parser.add_argument("--url", metavar="URL", help="server origin (default: $FINALECHAT_URL or saved login)")
    parser.add_argument("--token", metavar="TOKEN", help="API token (default: $FINALECHAT_TOKEN or saved login)")
