def load_config() -> dict:
    try:
        with CONFIG_PATH.open() as fh:
            data = json.load(fh)
        return data if isinstance(data, dict) else {}
    except (OSError, ValueError):
        return {}


def save_config(data: dict) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    try:
        os.chmod(CONFIG_DIR, 0o700)
    except OSError:
        pass
    tmp = CONFIG_PATH.with_suffix(".json.tmp")
    with tmp.open("w") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    os.chmod(tmp, 0o600)
    tmp.replace(CONFIG_PATH)


def resolve_base_url(explicit: str | None = None) -> str:
    url = explicit or os.environ.get("FINALECHAT_URL") or load_config().get("base_url") or DEFAULT_BASE_URL
    return str(url).rstrip("/")


def resolve_token(explicit: str | None = None) -> str | None:
    token = explicit or os.environ.get("FINALECHAT_TOKEN") or load_config().get("token")
    token = (token or "").strip()
    return token or None


# --------------------------------------------------------------------------- #
# HTTP client
# --------------------------------------------------------------------------- #


class NoAPIRedirect(urllib.request.HTTPRedirectHandler):
    def redirect_request(self, req, fp, code, msg, headers, newurl):
        # API endpoints are canonical. Never forward an account or connector
        # credential to a redirect target or turn a command POST into a GET.
        return None


class Client:
    def __init__(self, base_url: str, token: str | None):
        self.base_url = base_url.rstrip("/")
        self.token = token
        # A wall-clock budget (time.monotonic()) after which requests stop
        # retrying and shorten their timeouts; hooks that Claude Code kills
        # after 30 seconds set it so a slow server cannot stall a prompt.
        self.deadline: float | None = None

    # -- transport ---------------------------------------------------------

    def api_url(self, path: str) -> str:
        url = path if path.startswith(("http://", "https://")) else self.base_url + path
        base, target = urllib.parse.urlsplit(self.base_url), urllib.parse.urlsplit(url)
        def origin(value):
            return value.scheme, value.hostname, value.port or (443 if value.scheme == "https" else 80)
        if base.scheme not in ("http", "https") or not base.hostname or base.username or base.password or target.username or target.password or target.fragment or origin(base) != origin(target):
            raise CLIError("Authenticated requests must stay on the configured FinaleChat origin.")
        return url

    def request(self, method: str, path: str, body: dict | None = None, params: dict | None = None,
                timeout: float = 15.0, retries: int | None = None) -> dict:
        """One JSON request. GETs, and POSTs that carry an idempotency key, are
        retried on transport errors, 429 and 5xx with a short backoff, so a
        deploy or a blip neither ends a long wait nor loses a message."""
        if retries is None:
            retries = 3 if method == "GET" or (body or {}).get("client_key") else 0
        delay = 1.0
        for attempt in range(retries + 1):
            attempt_timeout = timeout
            if self.deadline is not None:
                left = self.deadline - time.monotonic()
                if left <= 1.0:
                    raise CLIError(f"Out of time talking to {self.base_url}", EXIT_API)
                attempt_timeout = min(timeout, left)
            try:
                return self._request_once(method, path, body, params, attempt_timeout)
            except NotSignedIn:
                raise
            except (APIError, CLIError) as err:
                if isinstance(err, APIError):
                    transient = err.status in (429, 502, 503, 504)
                else:
                    transient = err.exit_code == EXIT_API
                if not transient or attempt >= retries:
                    raise
                wait = delay
                if isinstance(err, APIError) and err.retry_after:
                    wait = max(wait, min(30.0, err.retry_after))
                if self.deadline is not None and time.monotonic() + wait + 1.0 > self.deadline:
                    raise
                time.sleep(wait)
                delay = min(8.0, delay * 2)
        raise CLIError("request failed", EXIT_API)  # not reached

    def _request_once(self, method: str, path: str, body: dict | None, params: dict | None,
                      timeout: float) -> dict:
        if not self.token:
            raise NotSignedIn()
        url = self.api_url(path)
        if params:
            clean = {k: v for k, v in params.items() if v is not None and v != ""}
            if clean:
                url += "?" + urllib.parse.urlencode(clean)
        data = None
        headers = {
            "Authorization": f"Bearer {self.token}",
            "Accept": "application/json",
            "User-Agent": USER_AGENT,
        }
        if body is not None:
            data = json.dumps(body).encode("utf-8")
            headers["Content-Type"] = "application/json"
        req = urllib.request.Request(url, data=data, method=method, headers=headers)
        try:
            with urllib.request.build_opener(NoAPIRedirect()).open(req, timeout=timeout) as resp:
                raw = resp.read()
        except urllib.error.HTTPError as err:
            with err:
                raw = err.read()
            try:
                retry_after = float(err.headers.get("Retry-After") or 0)
            except (TypeError, ValueError):
                retry_after = 0.0
            try:
                payload = json.loads(raw.decode("utf-8"))
                info = payload.get("error") or {}
                raise APIError(err.code, str(info.get("code") or "http_error"),
                               str(info.get("message") or f"HTTP {err.code}"), retry_after) from None
            except ValueError:
                raise APIError(err.code, "http_error", f"HTTP {err.code} from {url}", retry_after) from None
        except urllib.error.URLError as err:
            raise CLIError(f"Could not reach {self.base_url}: {err.reason}", EXIT_API) from None
        except (socket.timeout, TimeoutError):
            raise CLIError(f"Timed out talking to {self.base_url}", EXIT_API) from None
        if not raw:
            return {}
        try:
            return json.loads(raw.decode("utf-8"))
        except ValueError:
            raise CLIError(f"Unexpected non-JSON response from {url}", EXIT_API) from None

    def request_bytes(self, method: str, path: str, *, data: bytes | None = None,
                      content_type: str | None = None, timeout: float = 120.0) -> tuple[bytes, dict]:
        """Send a request with a prepared body and return (body bytes, headers)."""
        if not self.token:
            raise NotSignedIn()
        url = self.api_url(path)
        headers = {
            "Authorization": f"Bearer {self.token}",
            "Accept": "application/json, */*",
            "User-Agent": USER_AGENT,
        }
        if content_type:
            headers["Content-Type"] = content_type
        req = urllib.request.Request(url, data=data, method=method, headers=headers)
        try:
            with urllib.request.build_opener(NoAPIRedirect()).open(req, timeout=timeout) as resp:
                return resp.read(), {k.lower(): v for k, v in resp.headers.items()}
        except urllib.error.HTTPError as err:
            with err:
                raw = err.read()
            try:
                payload = json.loads(raw.decode("utf-8"))
                info = payload.get("error") or {}
                raise APIError(err.code, str(info.get("code") or "http_error"),
                               str(info.get("message") or f"HTTP {err.code}")) from None
            except ValueError:
                raise APIError(err.code, "http_error", f"HTTP {err.code} from {url}") from None
        except urllib.error.URLError as err:
            raise CLIError(f"Could not reach {self.base_url}: {err.reason}", EXIT_API) from None
        except socket.timeout:
            raise CLIError(f"Timed out talking to {self.base_url}", EXIT_API) from None

    def post_multipart(self, path: str, fields: dict, files: list) -> dict:
        """POST multipart/form-data. `files` is a list of (filename, content_type, bytes)."""
        boundary = "finalechat-" + secrets.token_hex(16)
        chunks: list[bytes] = []
        for name, value in fields.items():
            if value is None or value == "":
                continue
            chunks.append((f"--{boundary}\r\nContent-Disposition: form-data; name=\"{name}\"\r\n\r\n").encode("utf-8"))
            chunks.append(str(value).encode("utf-8"))
            chunks.append(b"\r\n")
        for filename, content_type, data in files:
            safe_name = filename.replace("\\", "_").replace('"', "_").replace("\r", "").replace("\n", "")
            chunks.append((f"--{boundary}\r\nContent-Disposition: form-data; name=\"file\"; "
                           f"filename=\"{safe_name}\"\r\nContent-Type: {content_type}\r\n\r\n").encode("utf-8"))
            chunks.append(data)
            chunks.append(b"\r\n")
        chunks.append(f"--{boundary}--\r\n".encode("utf-8"))
        body = b"".join(chunks)
        raw, _ = self.request_bytes("POST", path, data=body,
                                    content_type=f"multipart/form-data; boundary={boundary}",
                                    timeout=60 + len(body) / 100_000)
        try:
            return json.loads(raw.decode("utf-8")) if raw else {}
        except ValueError:
            raise CLIError("Unexpected non-JSON response from the server", EXIT_API) from None

    def download_attachment(self, ref: str, thumb: bool = False) -> tuple[bytes, str, str]:
        """Fetch an attachment by id or URL; returns (bytes, content type, filename)."""
        aid = attachment_id(ref)
        path = f"/api/v1/attachments/{aid}" + ("/thumb" if thumb else "")
        raw, headers = self.request_bytes("GET", path, timeout=300)
        content_type = (headers.get("content-type") or "application/octet-stream").split(";")[0].strip()
        filename = filename_from_disposition(headers.get("content-disposition", "")) or aid
        return raw, content_type, filename

    # -- helpers -----------------------------------------------------------

    @staticmethod
    def ref_path(ref: str) -> str:
        return urllib.parse.quote(ref, safe="")

    def me(self, timeout: float = 15.0) -> dict:
        return self.request("GET", "/api/v1/me", timeout=timeout)

    _remote_known: bool | None = None

    def remote_mode(self) -> bool:
        """Whether the user is in remote mode. A network blip keeps the last
        known answer rather than flipping to off, which would cancel live waits."""
        try:
            me = self.me(timeout=10)
            self._remote_known = bool(((me.get("user") or {}).get("settings") or {}).get("remote_mode"))
        except CLIError:
            if self._remote_known is None:
                return False
        return self._remote_known

    def update_settings(self, **fields) -> dict:
        return self.request("PATCH", "/api/v1/settings", body=fields).get("settings", {})

    def create_thread(self, external_id: str | None = None, title: str = "", agent: str = "",
                      meta: dict | None = None) -> dict:
        body: dict = {}
        if external_id:
            body["external_id"] = external_id
        if title:
            body["title"] = title
        if agent:
            body["agent"] = agent
        if meta:
            body["meta"] = meta
        return self.request("POST", "/api/v1/threads", body=body)

    def delete_message(self, message_id: str) -> dict:
        return self.request("DELETE", f"/api/v1/messages/{urllib.parse.quote(message_id, safe='')}")

    def get_thread(self, ref: str) -> dict:
        return self.request("GET", f"/api/v1/threads/{self.ref_path(ref)}").get("thread", {})

    def set_activity(self, ref: str, text: str, *, kind: str | None = None, ttl: int | None = None,
                     seq: int | None = None, title: str = "", agent: str = "") -> dict:
        """Set the thread's live status line; an empty text clears it. The
        thread must exist: an `ext:` reference is created first when it is
        missing (so `finalechat status` works before the first message)."""
        body: dict = {"text": text}
        if kind:
            body["kind"] = kind
        if ttl:
            body["ttl_seconds"] = int(ttl)
        if seq:
            body["seq"] = int(seq)
        path = f"/api/v1/threads/{self.ref_path(ref)}/activity"
        try:
            return self.request("POST", path, body=body, timeout=10, retries=0)
        except APIError as err:
            if err.status != 404 or not ref.startswith("ext:"):
                raise
            self.create_thread(ref[4:], title=title, agent=agent)
            return self.request("POST", path, body=body, timeout=10, retries=0)

    def clear_activity(self, ref: str, seq: int | None = None) -> dict:
        params = {"seq": seq} if seq else None
        return self.request("DELETE", f"/api/v1/threads/{self.ref_path(ref)}/activity", params=params, timeout=10)

    def list_threads(self, archived: bool = False, limit: int = 50, query: str | None = None) -> list:
        params = {"limit": limit, "q": query}
        if archived:
            params["archived"] = "true"
        return self.request("GET", "/api/v1/threads", params=params).get("threads", [])

    def post_message(self, ref: str, body: str, *, sender: str | None = None, important: bool = False,
                     notify: bool | None = None, fmt: str = "markdown", meta: dict | None = None,
                     title: str = "", agent: str = "", files: list | None = None,
                     client_key: str | None = None, activity: dict | None = None) -> dict:
        """Post a message; with `files` (list of (filename, content_type, bytes)) it is one multipart request.
        A `client_key` makes the post safe to retry (the server dedupes it). `activity` is the
        status line to show after the post, or {"text": "", "seq": N} for a sequenced clear
        (JSON posts only)."""
        payload: dict = {"body": body, "format": fmt, "importance": "important" if important else "normal",
                         "client_key": client_key or secrets.token_hex(16)}
        if activity is not None and not files:
            payload["activity"] = activity
        if sender:
            payload["sender"] = sender
        if notify is not None:
            payload["notify"] = notify
        if meta:
            payload["meta"] = meta
        if title:
            payload["title"] = title
        if agent:
            payload["agent"] = agent
        path = f"/api/v1/threads/{self.ref_path(ref)}/messages"
        if files:
            fields = dict(payload)
            if "meta" in fields:
                fields["meta"] = json.dumps(fields["meta"])
            if "notify" in fields:
                fields["notify"] = "true" if fields["notify"] else "false"
            return self.post_multipart(path, fields, files)
        return self.request("POST", path, body=payload)

    def list_messages(self, ref: str, *, after: str | None = None, before: str | None = None,
                      limit: int | None = None, wait: int | None = None, sender: str | None = None,
                      after_time: str | None = None) -> dict:
        params = {"after": after, "before": before, "limit": limit, "sender": sender, "after_time": after_time}
        timeout = 15.0
        if wait:
            params["wait"] = wait
            timeout = wait + 30
        return self.request("GET", f"/api/v1/threads/{self.ref_path(ref)}/messages", params=params, timeout=timeout)

    def ask(self, ref: str, prompt: str, options: list, *, multi: bool = False, freeform: bool = True,
            timeout_seconds: int | None = None, meta: dict | None = None, title: str = "", agent: str = "") -> dict:
        payload: dict = {"prompt": prompt, "options": options, "allow_freeform": freeform, "multi_select": multi,
                         "client_key": secrets.token_hex(16)}
        if timeout_seconds:
            payload["timeout_seconds"] = timeout_seconds
        if meta:
            payload["meta"] = meta
        if title:
            payload["title"] = title
        if agent:
            payload["agent"] = agent
        return self.request("POST", f"/api/v1/threads/{self.ref_path(ref)}/questions", body=payload)

    def get_question(self, qid: str, wait: int | None = None) -> dict:
        params = {"wait": wait} if wait else None
        timeout = (wait + 30) if wait else 15.0
        return self.request("GET", f"/api/v1/questions/{qid}", params=params, timeout=timeout).get("question", {})

    def cancel_question(self, qid: str) -> dict:
        return self.request("POST", f"/api/v1/questions/{qid}/cancel", body={}).get("question", {})


# --------------------------------------------------------------------------- #
# Waiting primitives
# --------------------------------------------------------------------------- #


def wait_for_answer(client: Client, qid: str, total: int, keep_going=None, chunk: int = POLL_CHUNK) -> dict:
    """Poll a question until it leaves the pending state or `total` seconds pass.

    `keep_going` is an optional callable checked between polls; returning False
    stops early (used by hooks when remote mode is switched off), so a hook
    passes a short `chunk` to notice the switch within seconds.
    """
    deadline = time.monotonic() + max(0, total)
    question = client.get_question(qid)
    while question.get("status") == "pending":
        remaining = int(deadline - time.monotonic())
        if remaining <= 0:
            break
        if keep_going is not None and not keep_going():
            break
        question = client.get_question(qid, wait=min(chunk, max(1, remaining)))
    return question


def latest_message_id(client: Client, ref: str) -> str | None:
    msgs = client.list_messages(ref, limit=1).get("messages") or []
    return msgs[-1]["id"] if msgs else None


def wait_for_replies(client: Client, ref: str, after: str | None, total: int, keep_going=None) -> list:
    """Block until user messages after `after` exist and return all of them
    (oldest first), or an empty list on timeout. Two replies sent within a
    second arrive together instead of the second one waiting a whole turn."""
    deadline = time.monotonic() + max(0, total)
    # Without a message to anchor on, the server anchors on its clock and
    # hands the instant back as waited_from; carrying it forward means a reply
    # that lands between two chunks is never skipped.
    after_time: str | None = None
    while True:
        remaining = int(deadline - time.monotonic())
        if remaining <= 0:
            return None
        if keep_going is not None and not keep_going():
            return None
        # Shorter chunks while a hook is waiting so a remote-mode switch is noticed quickly.
        chunk = HOOK_WAIT_CHUNK if keep_going is not None else 60
        resp = client.list_messages(ref, after=after, after_time=None if after else after_time, sender="user",
                                    wait=min(chunk, remaining))
        if after is None and resp.get("waited_from"):
            after_time = str(resp["waited_from"])
        msgs = resp.get("messages") or []
        if resp.get("anchor_unknown"):
            # The thread was deleted and recreated under the same id, so
            # the page ran from its start: those are old messages, not the
            # reply. Anchor on the newest and wait for what comes next.
            after = msgs[-1].get("id") if msgs else None
            if after is None:
                after_time = None
            continue
        # A "user" message posted by an agent (a mirrored terminal prompt) is
        # not the user replying from the app, and a tombstone is nothing at
        # all; keep waiting past both.
        skip = [m for m in msgs if m.get("origin") == "token" or m.get("deleted")]
        if skip and len(skip) == len(msgs):
            after = msgs[-1].get("id") or after
            continue
        msgs = [m for m in msgs if m.get("origin") != "token" and not m.get("deleted")]
        if msgs:
            return msgs


def wait_for_reply(client: Client, ref: str, after: str | None, total: int, keep_going=None) -> dict | None:
    """Block until the next user message after `after` arrives, or time out."""
    msgs = wait_for_replies(client, ref, after, total, keep_going=keep_going)
    return msgs[0] if msgs else None


def join_replies(replies: list) -> str:
    """One instruction from every reply the user sent, in order, with a hint
    for each attachment. A single reply reads as before."""
    parts = []
    for m in replies:
        body = str(m.get("body") or "").strip()
        if not body and message_attachments(m):
            body = "(no text)"
        if not body:
            continue
        parts.append(body + attachment_hint(m))
    if len(parts) <= 1:
        return parts[0] if parts else ""
    return "\n" + "\n".join(f"{i}. {p}" for i, p in enumerate(parts, 1))


def format_answer(question: dict) -> str:
    answer = question.get("answer") or {}
    lines = []
    selected = answer.get("selected") or []
    if selected:
        lines.append(", ".join(selected))
    text = (answer.get("text") or "").strip()
    if text:
        lines.append(text)
    return "\n".join(lines)


def answer_summary(question: dict) -> str:
    """One-line rendering used in hook and MCP replies."""
    answer = question.get("answer") or {}
    selected = answer.get("selected") or []
    text = (answer.get("text") or "").strip()
    parts = []
    if selected:
        parts.append(", ".join(selected))
    if text:
        parts.append(text)
    return " — ".join(parts) if parts else "(no answer)"


