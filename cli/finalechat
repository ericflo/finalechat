def mcp_target(arguments: dict) -> ThreadTarget:
    explicit = arguments.get("thread")
    title = arguments.get("title")
    return resolve_target(explicit if isinstance(explicit, str) and explicit else None,
                          title if isinstance(title, str) else None, None,
                          fallback_agent="MCP agent", fallback_prefix="mcp")


def mcp_image_block(client: Client, att: dict) -> dict | None:
    """An MCP image content block for an image attachment, thumbnail if the original is large."""
    if att.get("kind") != "image" or not att.get("id"):
        return None
    use_thumb = int(att.get("size") or 0) > MCP_IMAGE_INLINE_LIMIT and bool(att.get("thumb_url"))
    data, content_type, _name = client.download_attachment(str(att["id"]), thumb=use_thumb)
    if not content_type.startswith("image/"):
        return None
    return {"type": "image", "data": base64.b64encode(data).decode("ascii"), "mimeType": content_type}


def mcp_attachment_content(client: Client, messages: list, budget: int = MCP_MAX_IMAGES) -> tuple[list, list]:
    """(text lines describing non-image files, image blocks) for a list of
    messages. At most `budget` images are downloaded; the rest are described
    as fetchable files so the model is told exactly what it holds."""
    lines: list = []
    images: list = []
    for m in messages:
        for att in message_attachments(m):
            if att.get("kind") == "image" and len(images) < budget:
                try:
                    block = mcp_image_block(client, att)
                except CLIError as err:
                    block = None
                    lines.append(f"(could not load image {att.get('filename')}: {err})")
                if block is not None:
                    images.append(block)
                    lines.append(f"[image attached: {att.get('filename')} {att.get('width')}x{att.get('height')}, id {att.get('id')}]")
                    continue
            lines.append(f"[attachment: {att.get('filename')} ({att.get('content_type')}, {human_size(att.get('size'))}), "
                         f"id {att.get('id')} — use finalechat_fetch_attachment to save it]")
    return lines, images


def mcp_call(client: Client, name: str, arguments: dict):
    """Return a string or a list of MCP content blocks."""
    if name == "finalechat_send":
        message = str(arguments.get("message") or "").strip()
        paths = arguments.get("attachments") or []
        if not isinstance(paths, list):
            raise CLIError("attachments must be a list of file paths")
        files = read_local_files([str(p) for p in paths])
        if not message and not files:
            raise CLIError("message is required unless attachments are given")
        target = mcp_target(arguments)
        resp = client.post_message(target.ref, message, important=bool(arguments.get("important")),
                                   title=target.title, agent=target.agent, files=files)
        thread = resp.get("thread") or {}
        out = f"Sent to thread {thread.get('id')} ({thread.get('title') or 'untitled'}); message id {(resp.get('message') or {}).get('id')}"
        for att in message_attachments(resp.get("message") or {}):
            out += "\n" + attachment_line(client, att)
        return out

    if name == "finalechat_ask":
        prompt = str(arguments.get("prompt") or "").strip()
        if not prompt:
            raise CLIError("prompt is required")
        options = []
        for opt in arguments.get("options") or []:
            if isinstance(opt, dict) and str(opt.get("label") or "").strip():
                option = {"label": str(opt["label"]).strip()}
                if str(opt.get("description") or "").strip():
                    option["description"] = str(opt["description"]).strip()
                options.append(option)
            elif isinstance(opt, str) and opt.strip():
                options.append({"label": opt.strip()})
        freeform = arguments.get("allow_freeform", True)
        freeform = True if freeform is None else bool(freeform)
        if not options:
            freeform = True
        timeout = int(arguments.get("timeout_seconds") or 1800)
        target = mcp_target(arguments)
        resp = client.ask(target.ref, prompt, options, multi=bool(arguments.get("multi_select")),
                          freeform=freeform, timeout_seconds=timeout, title=target.title, agent=target.agent)
        question = resp.get("question") or {}
        question = wait_for_answer(client, question["id"], timeout)
        status = question.get("status")
        if status == "answered":
            answer = question.get("answer") or {}
            selected = ", ".join(answer.get("selected") or [])
            text = (answer.get("text") or "").strip()
            if selected and text:
                return f"Answer: {selected} / {text}"
            return f"Answer: {selected or text}"
        if status == "pending":
            return f"No answer within {timeout} seconds; question {question.get('id')} still pending."
        return f"The question was {status} before it was answered."

    if name == "finalechat_status":
        text = " ".join(str(arguments.get("text") or "").split())
        target = mcp_target(arguments)
        # One clock with the hooks and the CLI, so nothing overtakes it.
        seq = int(arguments.get("seq") or 0) or time.time_ns()
        if not text:
            try:
                client.clear_activity(target.ref, seq=seq)
            except APIError as err:
                if err.status != 404:
                    raise
            return "Status cleared."
        kind = str(arguments.get("kind") or "working")
        ttl = max(1, min(600, int(arguments.get("ttl_seconds") or 45)))
        client.set_activity(target.ref, text, kind=kind, ttl=ttl, seq=seq, title=target.title, agent=target.agent)
        return f"Status shown: {text} (lapses in {ttl}s or at your next message)"

    if name == "finalechat_delete_message":
        mid = str(arguments.get("message_id") or "").strip()
        if not mid:
            raise CLIError("message_id is required")
        client.delete_message(mid)
        return f"Deleted message {mid}."

    if name == "finalechat_wait_for_reply":
        timeout = int(arguments.get("timeout_seconds") or 1800)
        target = mcp_target(arguments)
        try:
            after = latest_message_id(client, target.ref)
            replies = wait_for_replies(client, target.ref, after, timeout)
        except APIError as err:
            raise missing_thread(err, target) from None
        if not replies:
            return f"No reply within {timeout} seconds."
        text = "Reply from the user: " + (join_replies(replies) or "(no text)")
        extra, images = mcp_attachment_content(client, replies)
        if extra:
            text += "\n" + "\n".join(extra)
        return [{"type": "text", "text": text}] + images

    if name == "finalechat_read":
        limit = int(arguments.get("limit") or 20)
        target = mcp_target(arguments)
        try:
            msgs = client.list_messages(target.ref, limit=max(1, min(200, limit))).get("messages") or []
        except APIError as err:
            raise missing_thread(err, target) from None
        if not msgs:
            return "(no messages yet)"
        lines = []
        images: list = []
        for m in msgs:
            stamp = (m.get("created_at") or "")[:19].replace("T", " ")
            lines.append(f"[{stamp}] {m.get('sender')}: {m.get('body', '')}")
            if message_attachments(m):
                extra, blocks = mcp_attachment_content(client, [m], budget=MCP_MAX_IMAGES - len(images))
                for line in extra:
                    lines.append("    " + line)
                images.extend(blocks)
        return [{"type": "text", "text": "\n".join(lines)}] + images

    if name == "finalechat_view_attachment":
        ref = str(arguments.get("attachment") or "").strip()
        if not ref:
            raise CLIError("attachment is required")
        aid = attachment_id(ref)
        # Try the original first; fall back to the thumbnail for large images.
        data, content_type, filename = client.download_attachment(aid)
        if not content_type.startswith("image/"):
            raise CLIError(f"{filename} is {content_type}, not an image; use finalechat_fetch_attachment to save it")
        if len(data) > MCP_IMAGE_INLINE_LIMIT:
            data, content_type, _ = client.download_attachment(aid, thumb=True)
        return [{"type": "text", "text": f"{filename} ({content_type}, {human_size(len(data))})"},
                {"type": "image", "data": base64.b64encode(data).decode("ascii"), "mimeType": content_type}]

    if name == "finalechat_fetch_attachment":
        ref = str(arguments.get("attachment") or "").strip()
        if not ref:
            raise CLIError("attachment is required")
        out = arguments.get("path")
        if not out:
            out = os.path.join("/tmp", "finalechat")
            os.makedirs(out, exist_ok=True)
        saved = save_attachment(client, ref, str(out))
        return f"Saved to {saved}"

    raise CLIError(f"Unknown tool: {name}")


def mcp_serve() -> int:
    stdin = sys.stdin.buffer
    stdout = sys.stdout.buffer
    client = Client(resolve_base_url(), resolve_token())

    def send(obj: dict) -> None:
        stdout.write((json.dumps(obj, ensure_ascii=False) + "\n").encode("utf-8"))
        stdout.flush()

    def reply(req_id, result) -> None:
        send({"jsonrpc": "2.0", "id": req_id, "result": result})

    def fail(req_id, code: int, message: str) -> None:
        send({"jsonrpc": "2.0", "id": req_id, "error": {"code": code, "message": message}})

    while True:
        line = stdin.readline()
        if not line:
            return EXIT_OK
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line.decode("utf-8"))
        except ValueError:
            send({"jsonrpc": "2.0", "id": None, "error": {"code": -32700, "message": "Parse error"}})
            continue
        if not isinstance(msg, dict):
            continue
        method = msg.get("method")
        req_id = msg.get("id")
        params = msg.get("params") or {}
        is_notification = "id" not in msg
        if method is None:
            continue  # a response to something we never sent
        try:
            if method == "initialize":
                requested = str(params.get("protocolVersion") or "")
                version = requested if requested in SUPPORTED_PROTOCOLS else SUPPORTED_PROTOCOLS[0]
                reply(req_id, {
                    "protocolVersion": version,
                    "capabilities": {"tools": {}},
                    "serverInfo": {"name": "finalechat", "version": VERSION},
                    "instructions": MCP_INSTRUCTIONS,
                })
            elif method == "notifications/initialized" or method.startswith("notifications/"):
                continue
            elif method == "ping":
                reply(req_id, {})
            elif method == "tools/list":
                reply(req_id, {"tools": mcp_tools()})
            elif method == "tools/call":
                name = str(params.get("name") or "")
                arguments = params.get("arguments") or {}
                if not isinstance(arguments, dict):
                    arguments = {}
                try:
                    result = mcp_call(client, name, arguments)
                    content = [{"type": "text", "text": result}] if isinstance(result, str) else result
                    reply(req_id, {"content": content, "isError": False})
                except CLIError as err:
                    reply(req_id, {"content": [{"type": "text", "text": f"Finalechat error: {err}"}],
                                   "isError": True})
            else:
                if not is_notification:
                    fail(req_id, -32601, f"Method not found: {method}")
        except Exception as err:  # noqa: BLE001
            print(f"finalechat mcp: {err}", file=sys.stderr)
            if not is_notification:
                fail(req_id, -32603, str(err))


def cmd_mcp(args) -> int:
    return mcp_serve()


