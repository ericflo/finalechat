def cmd_selftest(args) -> int:
    """Checks that never need a server; run by `make test-cli`."""
    failures = 0
    for given, want in REDACTION_CASES:
        got = redact_secrets(given)
        if got != want:
            failures += 1
            print(f"redact_secrets({given!r})\n   got  {got!r}\n   want {want!r}", file=sys.stderr)
    status = tool_status_text({"tool_name": "Bash", "cwd": "/x", "tool_input": {
        "command": "ansible-playbook site.yml -e 'very_long_inventory_group=production-us-west-2a' -e VAULT_TOKEN=deadbeefcafebabe0123456789abcdef01234567"}})
    if "deadbeef" in status or "••••" not in status:
        failures += 1
        print(f"tool_status_text leaked past the cut: {status!r}", file=sys.stderr)
    hint = attachment_hint({"attachments": [{"id": "abc", "filename": "Screen Shot 2026.png", "content_type": "image/png"}]})
    if "-o '/tmp/Screen Shot 2026.png'" not in hint:
        failures += 1
        print(f"attachment_hint is not shell-safe: {hint!r}", file=sys.stderr)
    print("selftest: ok" if not failures else f"selftest: {failures} failure(s)")
    return EXIT_OK if not failures else EXIT_USAGE


def tool_status_text(payload: dict) -> str:
    """One readable line for a tool call: "Running: go test ./..."."""
    name = str(payload.get("tool_name") or "a tool")
    inp = payload.get("tool_input")
    if not isinstance(inp, dict):
        inp = {}
    cwd = str(payload.get("cwd") or "").rstrip("/")

    def rel(value) -> str:
        path = str(value or "")
        if cwd and path.startswith(cwd + "/"):
            path = path[len(cwd) + 1:]
        return path

    if name == "Bash":
        command = str(inp.get("command") or "").strip()
        first = command.splitlines()[0].strip() if command else ""
        first = truncate(redact_secrets(first), 120)
        return f"Running: {first}" if first else "Running a command"
    if name == "Read":
        return f"Reading {rel(inp.get('file_path'))}".rstrip()
    if name == "Write":
        return f"Writing {rel(inp.get('file_path'))}".rstrip()
    if name in ("Edit", "MultiEdit", "NotebookEdit"):
        return f"Editing {rel(inp.get('file_path') or inp.get('notebook_path'))}".rstrip()
    if name in ("Grep", "Glob"):
        pattern = str(inp.get("pattern") or "")
        return f"Searching for {pattern}" if pattern else "Searching the code"
    if name in ("Agent", "Task"):
        desc = str(inp.get("description") or "")
        return f"Delegating: {desc}" if desc else "Delegating to a subagent"
    if name == "WebFetch":
        url = str(inp.get("url") or "")
        host = urllib.parse.urlparse(url).netloc if url else ""
        return f"Fetching {host or url}".rstrip()
    if name == "WebSearch":
        query = str(inp.get("query") or "")
        return f"Searching the web: {query}" if query else "Searching the web"
    if name in ("TodoWrite", "TaskCreate", "TaskUpdate"):
        return "Updating the plan"
    if name.startswith("mcp__"):
        return f"Using {name.split('__')[-1]}"
    return f"Using {name}"


def hook_claude_code() -> int:
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw) if raw.strip() else {}
    except ValueError:
        hook_log("hook input was not JSON")
        return EXIT_OK
    if not isinstance(payload, dict):
        return EXIT_OK
    event = str(payload.get("hook_event_name") or "")
    token = resolve_token()
    if not token:
        return EXIT_OK
    client = Client(resolve_base_url(), token)
    session_id = str(payload.get("session_id") or "unknown")
    cwd = str(payload.get("cwd") or os.getcwd())
    external_id = f"claude-code:{session_id}"
    ref = "ext:" + external_id
    title = os.path.basename(os.path.abspath(cwd)) or "Claude Code"
    agent = "Claude Code"
    try:
        if event == "SessionEnd":
            clear_by_cwd_pointer(cwd, session_id)
        else:
            write_by_cwd_pointer(cwd, external_id, session_id)
    except OSError as err:
        hook_log(f"pointer write failed: {err}")

    if event in ("SessionStart", "UserPromptSubmit", "Notification", "SessionEnd"):
        # Claude Code gives these hooks 30 seconds; leave headroom.
        client.deadline = time.monotonic() + 20

    if event == "SessionStart":
        meta = {"cwd": cwd, "hostname": hostname(), "source": payload.get("source") or ""}
        client.create_thread(external_id, title=title, agent=agent, meta=meta)
        return EXIT_OK

    if event == "UserPromptSubmit":
        prompt = str(payload.get("prompt") or "").strip()
        if not prompt or prompt.startswith("/"):
            return EXIT_OK
        client.post_message(ref, prompt, sender="user", meta={"via": "claude-code"}, title=title, agent=agent)
        spawn_status(ref, "Thinking…", "thinking", 120, title, agent)
        return EXIT_OK

    if event == "Stop":
        return hook_stop(client, payload, session_id, ref, title, agent)

    if event == "Notification":
        kind = str(payload.get("notification_type") or "")
        if kind == "auth_success":
            return EXIT_OK
        message = str(payload.get("message") or payload.get("title") or "Claude Code is waiting for you.").strip()
        body = f"**Claude Code needs you** — {message}"
        meta = {"kind": "notification", "notification_type": kind}
        client.post_message(ref, body, important=True, notify=True, meta=meta, title=title, agent=agent)
        spawn_status(ref, "Waiting for you in the terminal", "waiting", 300, title, agent)
        return EXIT_OK

    if event == "PreToolUse":
        if payload.get("tool_name") == "AskUserQuestion":
            return hook_ask_user_question(client, payload, ref, title, agent)
        spawn_status(ref, tool_status_text(payload), "tool", 120, title, agent)
        return EXIT_OK

    if event == "PostToolUse":
        spawn_status(ref, "Thinking…", "thinking", 120, title, agent)
        return EXIT_OK

    if event == "SessionEnd":
        reason = str(payload.get("reason") or "").strip()
        body = "Session ended" + (f" ({reason})" if reason else "")
        client.post_message(ref, body, sender="system", fmt="text", meta={"kind": "session_end"},
                            title=title, agent=agent)
        return EXIT_OK

    return EXIT_OK


def hook_stop(client: Client, payload: dict, session_id: str, ref: str, title: str, agent: str) -> int:
    transcript = str(payload.get("transcript_path") or "")
    if not transcript:
        clear_status(client, ref)
        return EXIT_OK
    uuid, text = last_assistant_text(transcript)
    if not text:
        clear_status(client, ref)
        return EXIT_OK
    state = load_session_state(session_id)
    if uuid and state.get("last_posted_uuid") == uuid:
        clear_status(client, ref)
        return EXIT_OK
    # Posting the reply clears the status line on the server. The key makes a
    # retry (or a re-run after a lost cache) return the same message.
    resp = client.post_message(ref, text, meta={"via": "claude-code", "transcript_uuid": uuid or ""},
                               title=title, agent=agent,
                               client_key=f"stop:{session_id}:{uuid}" if uuid else None)
    message = resp.get("message") or {}
    thread = resp.get("thread") or {}
    state.update({"last_posted_uuid": uuid, "thread_id": thread.get("id"), "last_message_id": message.get("id")})
    save_session_state(session_id, state)

    if not client.remote_mode():
        return EXIT_OK
    total = env_seconds("FINALECHAT_REPLY_WAIT", 1500)
    if total <= 0:
        return EXIT_OK

    def waiting_status() -> None:
        # Refreshed on every poll chunk, so the TTL is just over one chunk: a
        # killed hook takes its status with it within a minute.
        if status_enabled():
            try:
                client.set_activity(ref, "Waiting for your reply", kind="waiting", ttl=HOOK_WAIT_CHUNK + 30,
                                    seq=time.time_ns())
            except CLIError:
                pass

    def keep_going() -> bool:
        if not client.remote_mode():
            return False
        waiting_status()
        return True

    waiting_status()
    reply = wait_for_reply(client, ref, message.get("id"), total, keep_going=keep_going)
    if reply is None:
        clear_status(client, ref)
        return EXIT_OK
    body = str(reply.get("body") or "").strip()
    if not body and not message_attachments(reply):
        return EXIT_OK
    if not body:
        body = "(no text)"
    state["last_reply_id"] = reply.get("id")
    save_session_state(session_id, state)
    # Claude picks the reply up and starts working again.
    if status_enabled():
        try:
            client.set_activity(ref, "Thinking…", kind="thinking", ttl=120, seq=time.time_ns())
        except CLIError:
            pass
    reason = f"The user replied from their phone via Finalechat: {body}" + attachment_hint(reply)
    output = {"decision": "block", "reason": reason}
    sys.stdout.write(json.dumps(output) + "\n")
    sys.stdout.flush()
    return EXIT_OK


def answer_attachment_hints(client: Client, ref: str, created: list) -> str:
    """Files the user sent in the thread while answering (screenshots, logs)."""
    try:
        since = min(str(q.get("created_at") or "") for _item, q in created if q.get("created_at")) if created else ""
        msgs = client.list_messages(ref, limit=20, sender="user").get("messages") or []
    except (CLIError, ValueError):
        return ""
    hints = ""
    for m in msgs:
        if since and str(m.get("created_at") or "") < since:
            continue
        hints += attachment_hint(m)
    return hints


def hook_ask_user_question(client: Client, payload: dict, ref: str, title: str, agent: str) -> int:
    tool_input = payload.get("tool_input") or {}
    questions = tool_input.get("questions") if isinstance(tool_input, dict) else None
    if not isinstance(questions, list) or not questions:
        return EXIT_OK
    items = []
    for q in questions:
        if not isinstance(q, dict):
            continue
        text = str(q.get("question") or "").strip()
        if not text:
            continue
        header = str(q.get("header") or "").strip()
        options = []
        for opt in q.get("options") or []:
            if not isinstance(opt, dict):
                continue
            label = str(opt.get("label") or "").strip()
            if not label:
                continue
            option = {"label": label}
            desc = str(opt.get("description") or "").strip()
            if desc:
                option["description"] = desc
            options.append(option)
        items.append({"header": header, "question": text, "options": options,
                      "multi": bool(q.get("multiSelect"))})
    if not items:
        return EXIT_OK

    if not client.remote_mode():
        for item in items:
            lines = [f"**Claude Code is asking in the terminal:** {item['question']}"]
            for opt in item["options"]:
                line = f"- {opt['label']}"
                if opt.get("description"):
                    line += f" — {opt['description']}"
                lines.append(line)
            client.post_message(ref, "\n".join(lines), important=True, notify=True,
                                meta={"kind": "terminal_question", "header": item["header"]},
                                title=title, agent=agent)
        return EXIT_OK

    total = env_seconds("FINALECHAT_ASK_WAIT", 1500)
    created = []
    for item in items:
        prompt = f"{item['header']}: {item['question']}" if item["header"] else item["question"]
        resp = client.ask(ref, prompt, item["options"], multi=item["multi"], freeform=True,
                          timeout_seconds=total if total > 0 else None,
                          meta={"kind": "ask_user_question", "header": item["header"]},
                          title=title, agent=agent)
        question = resp.get("question") or {}
        if question.get("id"):
            created.append((item, question))
    if not created:
        return EXIT_OK

    deadline = time.monotonic() + total
    answers = []
    unanswered = []
    for item, question in created:
        remaining = int(deadline - time.monotonic())
        latest = wait_for_answer(client, question["id"], max(0, remaining), keep_going=client.remote_mode)
        if latest.get("status") == "answered":
            answers.append((item, latest))
        else:
            unanswered.append((item, latest))

    # Withdraw only what is still open; an answer the user already gave is
    # never thrown away.
    for _, question in unanswered:
        if question.get("status") == "pending":
            try:
                client.cancel_question(question["id"])
            except CLIError:
                pass
    if not answers:
        return EXIT_OK

    parts = []
    for item, question in answers:
        label = item["header"] or item["question"]
        parts.append(f"{label}: {answer_summary(question)}")
    reason = ("The user answered from their phone via Finalechat instead of the terminal. Answers: "
              + "; ".join(parts) + ". Use these answers and do not ask again.")
    if unanswered:
        missing = ", ".join((item["header"] or item["question"]) for item, _ in unanswered)
        reason += f" The user did not answer: {missing}; decide those yourself or ask again later."
    reason += answer_attachment_hints(client, ref, created)
    output = {"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny",
                                     "permissionDecisionReason": reason}}
    sys.stdout.write(json.dumps(output) + "\n")
    sys.stdout.flush()
    return EXIT_OK


def cmd_hook(args) -> int:
    if args.target != "claude-code":
        return EXIT_OK
    try:
        return hook_claude_code()
    except SystemExit:
        return EXIT_OK
    except BaseException:  # noqa: BLE001 - a hook must never break the session
        hook_log("hook failed:\n" + traceback.format_exc())
        return EXIT_OK


