def cli_path() -> str:
    """Absolute path of this executable, for hook commands."""
    invoked = os.path.realpath(os.path.abspath(sys.argv[0]))
    if os.path.isfile(invoked):
        # The file this process is running; hooks re-invoke it through the
        # interpreter, so it need not be executable itself.
        return invoked
    candidate = shutil.which("finalechat")
    if candidate:
        return os.path.realpath(candidate)
    return invoked


def hook_spec(command: str) -> dict:
    """The hook entries Finalechat installs, keyed by Claude Code event."""

    def entry(timeout: int, matcher: str | None = None) -> dict:
        item = {"hooks": [{"type": "command", "command": command, "timeout": timeout}]}
        if matcher is not None:
            item["matcher"] = matcher
        return item

    return {
        "SessionStart": entry(30),
        "UserPromptSubmit": entry(30),
        "Stop": entry(1800),
        "Notification": entry(30),
        # Every tool: AskUserQuestion is mirrored as a question (and may block
        # for the answer); any other tool just updates the live status line.
        "PreToolUse": entry(1800),
        "PostToolUse": entry(30),
        "SessionEnd": entry(30),
    }


def is_our_entry(entry: dict) -> bool:
    for hook in entry.get("hooks") or []:
        if isinstance(hook, dict) and HOOK_MARKER in str(hook.get("command", "")):
            return True
    return False


def load_settings(path: Path) -> dict:
    if not path.exists():
        return {}
    with path.open() as fh:
        text = fh.read()
    if not text.strip():
        return {}
    data = json.loads(text)
    if not isinstance(data, dict):
        raise CLIError(f"{path} does not contain a JSON object.")
    return data


def write_settings(path: Path, data: dict) -> Path | None:
    backup = None
    if path.exists():
        stamp = datetime.now().strftime("%Y%m%d-%H%M%S")
        backup = path.with_name(f"{path.name}.finalechat-backup-{stamp}")
        shutil.copy2(path, backup)
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    with tmp.open("w") as fh:
        json.dump(data, fh, indent=2)
        fh.write("\n")
    tmp.replace(path)
    return backup


def cmd_install(args) -> int:
    if args.target != "claude-code":
        raise CLIError("Only `claude-code` is supported right now.")
    settings_path = Path(args.settings).expanduser()
    command = f"{cli_path()} hook claude-code"
    data = load_settings(settings_path)
    hooks = data.get("hooks")
    if not isinstance(hooks, dict):
        hooks = {}
    for event, entry in hook_spec(command).items():
        existing = hooks.get(event)
        if not isinstance(existing, list):
            existing = []
        kept = [e for e in existing if not (isinstance(e, dict) and is_our_entry(e))]
        kept.append(entry)
        hooks[event] = kept
    data["hooks"] = hooks
    backup = write_settings(settings_path, data)
    print(f"Installed Finalechat hooks into {settings_path}")
    if backup:
        print(f"  previous settings backed up to {backup.name}")
    print("  events: SessionStart, UserPromptSubmit, Stop, Notification, PreToolUse, PostToolUse, SessionEnd")
    if not args.no_mcp:
        install_mcp(command.replace(" hook claude-code", ""))
    print()
    print("Every Claude Code session now posts to your phone. Turn on remote mode")
    print("(`finalechat remote on`, or the switch in the app) before you walk away so")
    print("sessions wait for your replies and answers instead of the terminal.")
    print("Restart running Claude Code sessions to pick up the hooks.")
    return EXIT_OK


def install_mcp(cli: str) -> None:
    claude = shutil.which("claude")
    if not claude:
        print("  MCP: `claude` not found on PATH; register manually with")
        print(f"       claude mcp add --scope user finalechat -- {cli} mcp")
        return
    try:
        check = subprocess.run([claude, "mcp", "get", "finalechat"], capture_output=True, text=True, timeout=30)
        if check.returncode == 0:
            subprocess.run([claude, "mcp", "remove", "--scope", "user", "finalechat"],
                           capture_output=True, text=True, timeout=30)
        result = subprocess.run([claude, "mcp", "add", "--scope", "user", "finalechat", "--", cli, "mcp"],
                                capture_output=True, text=True, timeout=30)
        if result.returncode == 0:
            print("  MCP: registered the `finalechat` server (user scope)")
        else:
            print("  MCP: registration failed; register manually with")
            print(f"       claude mcp add --scope user finalechat -- {cli} mcp")
            if result.stderr.strip():
                print("       " + result.stderr.strip().splitlines()[-1])
    except (OSError, subprocess.SubprocessError) as err:
        print(f"  MCP: could not run claude ({err}); register manually with")
        print(f"       claude mcp add --scope user finalechat -- {cli} mcp")


def cmd_uninstall(args) -> int:
    if args.target != "claude-code":
        raise CLIError("Only `claude-code` is supported right now.")
    settings_path = Path(args.settings).expanduser()
    data = load_settings(settings_path)
    hooks = data.get("hooks")
    removed = 0
    if isinstance(hooks, dict):
        for event in list(hooks.keys()):
            entries = hooks.get(event)
            if not isinstance(entries, list):
                continue
            kept = [e for e in entries if not (isinstance(e, dict) and is_our_entry(e))]
            removed += len(entries) - len(kept)
            if kept:
                hooks[event] = kept
            else:
                del hooks[event]
        if not hooks:
            data.pop("hooks", None)
    if removed:
        write_settings(settings_path, data)
    print(f"Removed {removed} Finalechat hook entr{'y' if removed == 1 else 'ies'} from {settings_path}")
    if not args.no_mcp:
        claude = shutil.which("claude")
        if claude:
            subprocess.run([claude, "mcp", "remove", "--scope", "user", "finalechat"],
                           capture_output=True, text=True, timeout=30)
            print("  MCP: removed the `finalechat` server if it was registered")
    return EXIT_OK


